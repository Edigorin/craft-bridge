' Generated by craft-bridge 0.1.0 from "item.craftx" - review before running.
' Units: the SolidWorks API always takes metres and radians.
Option Explicit

Dim swApp As SldWorks.SldWorks
Dim swDoc As SldWorks.ModelDoc2
Dim swSketchMgr As SketchManager
Dim reportPath As String
Dim gMsg As String
Dim gPlane As String
Dim gProbeLog As String
Dim gProbeReason As String
Dim gMap00(0 To 2) As Double
Dim gMap01(0 To 2) As Double
Dim gMap10(0 To 2) As Double
Dim gMap11(0 To 2) As Double
Dim gMapValid(0 To 2) As Boolean
Dim gMapSide(0 To 2) As Long
Dim gFrame(0 To 2, 0 To 11) As Double
Dim gOmit As String
Dim gDimToggle As Boolean
Dim gDimToggleSaved As Boolean
Dim gDoc As Object
Dim gFeatMgr As Object
Dim regName(0 To 0) As String
Dim regSign(0 To 0) As Double
Dim skName0 As String
Dim pt0(0 To 2) As Object
Dim sl0(0 To 0) As Object
Dim ci0(0 To 0) As Object

Sub main()
    Dim template As String
    Dim ok As Boolean
    Dim st As String
    Dim stopModel As Boolean
    Dim stepIdx As Long
    Dim closedOk As Boolean
    Dim cleanupMode As String
    stepIdx = -1
    On Error GoTo Fail

    ' ---- report setup (before any model mutation) ----
    reportPath = ReportPathFromHost()
    If reportPath = "" Then Err.Raise vbObjectError + 513, "craft-bridge", "no report path: CRAFT_BRIDGE_REPORT is unset and no path file exists in TEMP"
    StartReport
    WriteLine "{""type"":""header"",""macro"":""item.craftx"",""bridge_version"":""0.1.0""}"

    ' ---- fresh part from the default template (before recipe step 0) ----
Set swApp = Application.SldWorks
gDimToggle = swApp.GetUserPreferenceToggle(swUserPreferenceToggle_e.swInputDimValOnCreate)
gDimToggleSaved = True
swApp.SetUserPreferenceToggle swUserPreferenceToggle_e.swInputDimValOnCreate, False
If swApp.GetUserPreferenceToggle(swUserPreferenceToggle_e.swInputDimValOnCreate) Then Err.Raise vbObjectError + 528, "craft-bridge", "the input-dimension-value dialog could not be disabled"
template = swApp.GetUserPreferenceStringValue(swUserPreferenceStringValue_e.swDefaultTemplatePart)
If template = "" Then Err.Raise vbObjectError + 514, "craft-bridge", "no default part template is configured"
Set swDoc = swApp.NewDocument(template, 0, 0, 0)
If swDoc Is Nothing Then Err.Raise vbObjectError + 515, "craft-bridge", "NewDocument returned nothing"
Set swSketchMgr = swDoc.SketchManager
If swSketchMgr Is Nothing Then Err.Raise vbObjectError + 521, "craft-bridge", "the sketch manager is unavailable"
Set gFeatMgr = swDoc.FeatureManager
If gFeatMgr Is Nothing Then Err.Raise vbObjectError + 522, "craft-bridge", "the feature manager is unavailable"
Set gDoc = swDoc
WriteStep stepIdx, "document.new", "created", "fresh part from the default template"

    ' ---- step 0: timeline.add ----
    stepIdx = 0
    If Not stopModel Then
        st = BuildSketch0()
    Else
        st = "not-executed"
        gMsg = "after the first stopped step"
    End If
    WriteStep stepIdx, "timeline.add", st, gMsg
    If st = "failed" Then stopModel = True

    ' ---- step 1: vendor.future_thing ----
    stepIdx = 1
    WriteStep stepIdx, "vendor.future_thing", "not-executed", "no translation and no snapshot; replay terminates here"
    stopModel = True

    ' ---- step 2: timeline.add ----
    stepIdx = 2
    WriteStep stepIdx, "timeline.add", "not-executed", "after the first unmapped step"

    If gDimToggleSaved And Not swApp Is Nothing Then swApp.SetUserPreferenceToggle swUserPreferenceToggle_e.swInputDimValOnCreate, gDimToggle
    If gDimToggleSaved And Not swApp Is Nothing Then If swApp.GetUserPreferenceToggle(swUserPreferenceToggle_e.swInputDimValOnCreate) <> gDimToggle Then WriteStep stepIdx, "toggle-restore", "failed", "the input-dimension-value preference did not restore"
    cleanupMode = CloseMode()
    If cleanupMode = "close" Then
    CloseOwnedDoc closedOk
    If closedOk Then
    WriteLine "{""type"":""summary"",""status"":""ok""}"
    Else
    WriteStep stepIdx, "close", "failed", "the owned document could not be confirmed closed"
    WriteLine "{""type"":""summary"",""status"":""failed""}"
    End If
    ElseIf cleanupMode = "keep" Then
    WriteStep stepIdx, "owned-document", "kept-open", OwnedDocTitle()
    WriteLine "{""type"":""summary"",""status"":""ok""}"
    Else
    WriteStep stepIdx, "close-mode", "failed", "the cleanup mode could not be established"
    WriteLine "{""type"":""summary"",""status"":""failed""}"
    End If
    Exit Sub

Fail:
    ' Capture the error FIRST: executing On Error resets Err.
    Dim errNum As Long, errMsg As String
    errNum = Err.Number
    errMsg = Err.Description
    ' The report must survive failure: open it if needed, write what happened
    ' and the completion signal, then leave the model as it is.
    On Error Resume Next
    If reportPath = "" Then reportPath = ReportPathFromHost()
    If reportPath <> "" Then
        WriteStep stepIdx, "macro", "failed", "err " & Trim(Str(errNum)) & ": " & errMsg
    End If
        If gDimToggleSaved And Not swApp Is Nothing Then swApp.SetUserPreferenceToggle swUserPreferenceToggle_e.swInputDimValOnCreate, gDimToggle
    If gDimToggleSaved And Not swApp Is Nothing Then If swApp.GetUserPreferenceToggle(swUserPreferenceToggle_e.swInputDimValOnCreate) <> gDimToggle Then WriteStep stepIdx, "toggle-restore", "failed", "the input-dimension-value preference did not restore"
    cleanupMode = CloseMode()
    If cleanupMode = "close" Then
    CloseOwnedDoc closedOk
    End If
    If reportPath <> "" Then
        WriteLine "{""type"":""summary"",""status"":""failed""}"
    End If
End Sub

' Sketch step 0: "Round"
Function BuildSketch0() As String
    On Error GoTo HardFail
    Dim ok As Boolean
    Dim skFeat As SldWorks.Feature
    gMsg = ""
    gOmit = ""
    ok = OpenSketchOnPlane(0, "XY")
    If Not ok Then gMsg = "no origin plane carries the XY frame u=(1,0,0) v=(0,1,0) n=(0,0,1); probed: " & gProbeLog & "; tree scan saw: " & TreeSummary(): GoTo SketchFailed
    Set skFeat = swSketchMgr.ActiveSketch
    skName0 = skFeat.Name
    DrawGeometry0
    If Not Relations0() Then GoTo Degrade
    If Not Dims0() Then GoTo Degrade
    If Not VerifySketch0() Then GoTo Degrade
    swSketchMgr.InsertSketch True
    If Not NoSketchIsOpen() Then gMsg = "the sketch context did not close": GoTo SketchFailed
    If Not VerifySketch0() Then gMsg = "closed-context verification failed: the solved geometry differs after closing": GoTo SketchFailed
    gMsg = "constraints not replayed: constraint 0 (radius) refers to curve 0, which is not a circle, pattern_point"
    BuildSketch0 = "degraded"
    If gOmit <> "" Then
        gMsg = gMsg & " | omitted: " & gOmit
        BuildSketch0 = "degraded"
    End If
    Exit Function

Degrade:
' Restore, do not merely delete relations: wipe the sketch contents,
' redraw at the stored coordinates, reapply driving dimensions, verify again.
' CleanSketch revalidates the whole cycle: map invalidated first, the
' deletion verified, the frame re-probed and the sketch identity
' reacquired; its refusal fails the sketch with the named reason.
    If Not CleanSketch0() Then GoTo SketchFailed
    DrawGeometry0
    If Not Dims0() Then GoTo SketchFailed
    If Not VerifySketch0() Then GoTo SketchFailed
    swSketchMgr.InsertSketch True
    If Not NoSketchIsOpen() Then gMsg = "the sketch context did not close": GoTo SketchFailed
    If Not VerifySketch0() Then gMsg = "closed-context verification failed after recreation": GoTo SketchFailed
    gMsg = "rebuilt as geometry plus driving dimensions"
    If gOmit <> "" Then gMsg = gMsg & " | omitted: " & gOmit
    BuildSketch0 = "degraded"
    Exit Function

SketchFailed:
    On Error Resume Next
    CloseSketchIfOpen
    BuildSketch0 = "failed"
    Exit Function

HardFail:
    ' Capture the error FIRST: executing an On Error statement resets Err.
    Dim errNum As Long, errMsg As String
    errNum = Err.Number
    errMsg = Err.Description
    On Error Resume Next
    CloseSketchIfOpen
    gMsg = "err " & Trim(Str(errNum)) & ": " & errMsg
    BuildSketch0 = "failed"
End Function

Sub DrawGeometry0()
    Set sl0(0) = swSketchMgr.CreateLine(MapU(0, 0.01, 0.0), MapV(0, 0.01, 0.0), 0#, MapU(0, 0.015, 0.0), MapV(0, 0.015, 0.0), 0#)
    Set pt0(0) = sl0(0).GetStartPoint2
    Set pt0(1) = sl0(0).GetEndPoint2
    Set ci0(0) = swSketchMgr.CreateCircleByRadius(MapU(0, 0.0, 0.0), MapV(0, 0.0, 0.0), 0#, 0.005)
    Set pt0(2) = ci0(0).GetCenterPoint2
    swDoc.ClearSelection2 True
End Sub

Function Relations0() As Boolean
    On Error GoTo RelFail
    Const TOL As Double = 0.000001
    Dim vA As Variant
    Dim vB As Variant
    Dim vC As Variant
    Dim vD As Variant
    Dim chk As Double
    Relations0 = True
    Exit Function
RelFail:
    If Err.Number <> 0 Then gMsg = "err " & Trim(Str(Err.Number)) & ": " & Err.Description
    If gMsg = "" Then gMsg = "a sketch relation could not be applied"
    Relations0 = False
End Function

Function Dims0() As Boolean
    On Error GoTo DimFail
    Const TOL As Double = 0.000001
    gMsg = ""
    Dim dd As SldWorks.DisplayDimension
    Dim dm As SldWorks.Dimension
    Dim ax As Double
    Dim ay As Double
    Dim bx As Double
    Dim by As Double
    Dim ds As Double
    Dim dt As Double
    Dim proj As Double
    Dim other As Double
    Dim created As Double
    Dim signVal As Double
    Dim sT As Double
    Dim tT As Double
    Dim mx As Double
    Dim my As Double
    Dim mz As Double
    Dim axClass As Long
    Dim v2 As Variant
    Dim nax As Double
    Dim nay As Double
    Dim nbx As Double
    Dim nby As Double
    Dim chk As Double
    Dim chk2 As Double
    Dims0 = True
    Exit Function
DimFail:
    If Err.Number <> 0 Then gMsg = "err " & Trim(Str(Err.Number)) & ": " & Err.Description
    If gMsg = "" Then gMsg = "a driving dimension could not be added"
    Dims0 = False
End Function

Function VerifySketch0() As Boolean
    Const TOL As Double = 0.000001
    Dim v As Variant
    Dim cph As Object
    On Error GoTo VerifyFail
    v = sl0(0).GetStartPoint
    If Abs(v(0) - MapU(0, 0.01, 0.0)) > TOL Then GoTo VerifyFail
    If Abs(v(1) - MapV(0, 0.01, 0.0)) > TOL Then GoTo VerifyFail
    If Abs(v(2)) > TOL Then GoTo VerifyFail
    v = sl0(0).GetEndPoint
    If Abs(v(0) - MapU(0, 0.015, 0.0)) > TOL Then GoTo VerifyFail
    If Abs(v(1) - MapV(0, 0.015, 0.0)) > TOL Then GoTo VerifyFail
    If Abs(v(2)) > TOL Then GoTo VerifyFail
    Set cph = ci0(0).GetCenterPoint2
    If cph Is Nothing Then GoTo VerifyFail
    If Abs(cph.X - MapU(0, 0.0, 0.0)) > TOL Then GoTo VerifyFail
    If Abs(cph.Y - MapV(0, 0.0, 0.0)) > TOL Then GoTo VerifyFail
    If Abs(cph.Z) > TOL Then GoTo VerifyFail
    If Abs(ci0(0).GetRadius - 0.005) > TOL Then GoTo VerifyFail
    VerifySketch0 = True
    Exit Function
VerifyFail:
    VerifySketch0 = False
End Function

Function CleanSketch0() As Boolean
    On Error GoTo CleanFail
    Dim anySel As Boolean
    Dim okSel As Boolean
    Dim cleanOk As Boolean
    Dim pts As Variant
    Dim ub As Long
    Dim skFeat As SldWorks.Feature
    CleanSketch0 = False
    gMsg = ""
    SolveSketch skName0
    ClearMap 0
    If Not sl0(0) Is Nothing Then
    okSel = sl0(0).Select(anySel)
    If Not okSel Then gMsg = "a sketch entity would not select for deletion": GoTo CleanFail
    anySel = True
    End If
    If Not ci0(0) Is Nothing Then
    okSel = ci0(0).Select(anySel)
    If Not okSel Then gMsg = "a sketch entity would not select for deletion": GoTo CleanFail
    anySel = True
    End If
    If anySel Then swDoc.EditDelete
    swDoc.ClearSelection2 True
    ' Verify the deletion through the pinned point enumeration (every
    ' line endpoint and circle centre is a sketch point): only a PROVEN-
    ' EMPTY collection counts. A fetch, type or bounds failure refuses -
    ' a failed query is never proof of emptiness.
    On Error Resume Next
    Err.Clear
    pts = swSketchMgr.ActiveSketch.GetSketchPoints2
    If Err.Number <> 0 Then
    On Error GoTo CleanFail
    gMsg = "the point collection could not be read after deletion: err " & Trim(Str(Err.Number))
    GoTo CleanFail
    End If
    If Not IsArray(pts) Then
    On Error GoTo CleanFail
    gMsg = "the point collection did not come back as an array after deletion"
    GoTo CleanFail
    End If
    Err.Clear
    ub = UBound(pts)
    If Err.Number = 0 Then
    On Error GoTo CleanFail
    gMsg = "sketch contents deletion is not verified: " & Trim(Str(ub + 1)) & " points remain"
    GoTo CleanFail
    End If
    If Err.Number <> 9 Then
    On Error GoTo CleanFail
    gMsg = "the point collection bounds could not be established: err " & Trim(Str(Err.Number))
    GoTo CleanFail
    End If
    On Error GoTo CleanFail
    If Not AcceptAndPublish(0, "XY", gProbeReason) Then gMsg = "the sketch frame could not be re-accepted after recreation: " & gProbeReason: GoTo CleanFail
    Set skFeat = swSketchMgr.ActiveSketch
    If skFeat Is Nothing Then gMsg = "the recreated sketch has no active sketch object": GoTo CleanFail
    skName0 = skFeat.Name
    CleanSketch0 = True
    Exit Function
CleanFail:
    If Err.Number <> 0 Then gMsg = "err " & Trim(Str(Err.Number)) & ": " & Err.Description
    CleanSketch0 = False
End Function

Sub ClearSlotsAll()
    Dim i As Long
    For i = 0 To UBound(regName)
        regName(i) = ""
        regSign(i) = 1#
    Next i
End Sub

Function SlotRef(ByVal slot As Long) As String
    If regSign(slot) < 0 Then
    SlotRef = "(-1*" & """" & regName(slot) & """" & ")"
    Else
    SlotRef = """" & regName(slot) & """"
    End If
End Function

' Write one step line and flush it to disk immediately.
' The plane whose sketch frame exactly matches the SolidCraft frame for the
' requested plane: axes, signs, and the sketch origin at the model origin.
' Plane names and tree positions are per config (one seat maps Front to the
' ZY plane), so no name or position is trusted; and verbatim (u, v) replay
' only lands coordinates where they belong on the frame the recipe implies.
' Anything else is refused and fails closed - coordinates are never
' silently reinterpreted (docs/mapping.md, Orientation). The probe leaves
' the sketch open on success. On failure the probe sketch is closed,
' deleted as one owned feature, and the deletion is verified.
Function OpenSketchOnPlane(ByVal idx As Long, ByVal which As String) As Boolean
Dim feat As SldWorks.Feature, skFeat As SldWorks.Feature, ok As Boolean
Set feat = swDoc.FirstFeature
Do While Not feat Is Nothing
If InStr(1, feat.GetTypeName2(), "lane", vbTextCompare) > 0 Then
ok = feat.Select(False)
If ok Then
swSketchMgr.InsertSketch True
Set skFeat = swSketchMgr.ActiveSketch
If skFeat Is Nothing Then
gProbeLog = gProbeLog & feat.Name & ": no sketch opened; "
ElseIf PlaneIsSource(which) Then
ClearMap idx
If AcceptAndPublish(idx, which, gProbeReason) Then
OpenSketchOnPlane = True
Exit Function
End If
gProbeLog = gProbeLog & feat.Name & ": map refused: " & gProbeReason & " strict-match=" & CStr(SketchFrameIs(which)) & "; "
If Not DiscardProbeSketch(skFeat) Then Err.Raise vbObjectError + 520, "craft-bridge", "the refused probe sketch could not be confirmed deleted; probed: " & gProbeLog
Else
gProbeLog = gProbeLog & feat.Name & ": " & FrameText() & " strict-match=" & CStr(SketchFrameIs(which)) & "; "
If Not DiscardProbeSketch(skFeat) Then Err.Raise vbObjectError + 520, "craft-bridge", "the probe sketch could not be confirmed deleted; probed: " & gProbeLog
End If
End If
End If
Set feat = feat.GetNextFeature
Loop
OpenSketchOnPlane = False
End Function

' The plane feature's own runtime name (never assumed) for call shapes that
' need the plane selected as a FEATURE, like mirrors. The probe sketch is
' discarded: the mirror needs the plane, not a sketch.
Function PlaneNameFor(ByVal which As String) As String
Dim feat As SldWorks.Feature, skFeat As SldWorks.Feature, ok As Boolean
Set feat = swDoc.FirstFeature
Do While Not feat Is Nothing
If InStr(1, feat.GetTypeName2(), "lane", vbTextCompare) > 0 Then
ok = feat.Select(False)
If ok Then
swSketchMgr.InsertSketch True
Set skFeat = swSketchMgr.ActiveSketch
If skFeat Is Nothing Then
gProbeLog = gProbeLog & feat.Name & ": no sketch opened; "
ElseIf PlaneIsSource(which) Then
gProbeLog = gProbeLog & feat.Name & ": " & FrameText() & " strict-match=" & CStr(SketchFrameIs(which)) & "; "
If Not DiscardProbeSketch(skFeat) Then Err.Raise vbObjectError + 520, "craft-bridge", "the probe sketch could not be confirmed deleted; probed: " & gProbeLog
PlaneNameFor = feat.Name
Exit Function
Else
gProbeLog = gProbeLog & feat.Name & ": " & FrameText() & " strict-match=" & CStr(SketchFrameIs(which)) & "; "
If Not DiscardProbeSketch(skFeat) Then Err.Raise vbObjectError + 520, "craft-bridge", "the probe sketch could not be confirmed deleted; probed: " & gProbeLog
End If
End If
End If
Set feat = feat.GetNextFeature
Loop
End Function

' The strict frame predicate (DIAGNOSTIC ONLY): the sketch frame exactly
' equal to the SolidCraft frame for the plane (its plane.rs 29-34): XZ has
' v = -Z, n = +Y; the sketch origin at the model origin. RETIRED from the
' acceptance path (owner decision 2026-11-13, frame adaptation): acceptance
' is PlaneIsSource plus the fail-closed map validation in AcceptAndPublish.
' This predicate remains to report how close a probed frame came to strict
' equality. The model-to-sketch transform is row-major with rows = model
' axes in sketch coordinates, so the sketch axes in model coordinates are
' its columns: u = (a0, a3, a6), v = (a1, a4, a7), n = (a2, a5, a8).
Function SketchFrameIs(ByVal which As String) As Boolean
Dim tr As Variant, a As Variant, ok As Boolean
On Error Resume Next
Set tr = swSketchMgr.ActiveSketch.ModelToSketchTransform
If Err.Number <> 0 Then Exit Function
a = tr.ArrayData
If Abs(a(9)) > 0.000001 Or Abs(a(10)) > 0.000001 Or Abs(a(11)) > 0.000001 Then Exit Function
Select Case which
Case "XY"
ok = VecIs(a(0), a(3), a(6), 1#, 0#, 0#) And VecIs(a(1), a(4), a(7), 0#, 1#, 0#) And VecIs(a(2), a(5), a(8), 0#, 0#, 1#)
Case "XZ"
ok = VecIs(a(0), a(3), a(6), 1#, 0#, 0#) And VecIs(a(1), a(4), a(7), 0#, 0#, -1#) And VecIs(a(2), a(5), a(8), 0#, 1#, 0#)
Case "YZ"
ok = VecIs(a(0), a(3), a(6), 0#, 1#, 0#) And VecIs(a(1), a(4), a(7), 0#, 0#, 1#) And VecIs(a(2), a(5), a(8), 1#, 0#, 0#)
End Select
SketchFrameIs = ok
End Function

' The acceptance predicate (frame adaptation): the probe sketch must sit on
' the geometric source plane - translation at the model origin and the
' normal parallel to the source normal (either sign: the same geometric
' plane). Strict frame equality is no longer required (owner decision
' 2026-11-13); the adaptation map published by AcceptAndPublish is what
' makes that safe. Tolerance 1e-6.
Function PlaneIsSource(ByVal which As String) As Boolean
Dim tr As Object
Dim a As Variant
Dim nx As Double
Dim ny As Double
Dim nz As Double
On Error Resume Next
PlaneIsSource = False
Err.Clear
Set tr = swSketchMgr.ActiveSketch.ModelToSketchTransform
If Err.Number <> 0 Then Exit Function
Err.Clear
a = tr.ArrayData
If Err.Number <> 0 Then Exit Function
If Abs(a(9)) > 0.000001 Or Abs(a(10)) > 0.000001 Or Abs(a(11)) > 0.000001 Then Exit Function
nx = a(2)
ny = a(5)
nz = a(8)
Select Case which
Case "XY"
If Abs(Abs(nz) - 1#) > 0.000001 Then Exit Function
Case "XZ"
If Abs(Abs(ny) - 1#) > 0.000001 Then Exit Function
Case "YZ"
If Abs(Abs(nx) - 1#) > 0.000001 Then Exit Function
Case Else
Exit Function
End Select
PlaneIsSource = True
End Function

' Direction equality with sign, on normalized vectors: the transform may
' carry a uniform scale, the axes must still be exactly the expected ones.
Function VecIs(ByVal ax As Double, ByVal ay As Double, ByVal az As Double, ByVal bx As Double, ByVal by As Double, ByVal bz As Double) As Boolean
Dim L As Double
L = Sqr(ax * ax + ay * ay + az * az)
If Abs(L) < 0.000001 Then Exit Function
VecIs = Abs(ax / L - bx) < 0.000001 And Abs(ay / L - by) < 0.000001 And Abs(az / L - bz) < 0.000001
End Function

' The active sketch's frame as report text: the fail-closed messages name
' exactly what each probed plane offered.
Function FrameText() As String
Dim tr As Variant, a As Variant
On Error Resume Next
Set tr = swSketchMgr.ActiveSketch.ModelToSketchTransform
If Err.Number <> 0 Then FrameText = "(no frame)": Exit Function
a = tr.ArrayData
FrameText = "u=(" & Vec3Text(a(0), a(3), a(6)) & ") v=(" & Vec3Text(a(1), a(4), a(7)) & ") n=(" & Vec3Text(a(2), a(5), a(8)) & ") o=(" & Vec3Text(a(9), a(10), a(11)) & ")"
End Function

Function Vec3Text(ByVal x As Double, ByVal y As Double, ByVal z As Double) As String
Vec3Text = Trim(Str(x)) & "," & Trim(Str(y)) & "," & Trim(Str(z))
End Function

' A live feature-tree lookup by name. Returns the feature when a complete
' walk found it; returns Nothing with uncertain = False only when a
' complete walk proves it absent; uncertain = True whenever the walk or
' the name failed. Absence is never inferred from a failed query, and an
' empty name is never sent to any API.
Function FindFeatureByName(ByVal nm As String, ByRef uncertain As Boolean) As SldWorks.Feature
Dim feat As SldWorks.Feature, fn As String
Set FindFeatureByName = Nothing
uncertain = True
If nm = "" Then Exit Function
On Error Resume Next
Err.Clear
Set feat = swDoc.FirstFeature
Do While Not feat Is Nothing
If Err.Number <> 0 Then Exit Function
Err.Clear
fn = feat.Name
If Err.Number <> 0 Then Exit Function
If fn = nm Then
Set FindFeatureByName = feat
uncertain = False
Exit Function
End If
Err.Clear
Set feat = feat.GetNextFeature
Loop
If Err.Number = 0 Then uncertain = False
End Function

' Close the probe sketch and delete exactly the feature that was created
' for it - never a blind EditDelete, never a stale-object test. The name
' is captured while the object is alive and validated; the close is
' confirmed; the delete runs from a clean selection of the one feature the
' live tree returns; and the deletion is verified the same way. Closing an
' empty sketch may already have removed it - that is a clean result. True
' = the probe sketch is proven gone; every uncertain state fails closed.
Function DiscardProbeSketch(ByVal skFeat As SldWorks.Feature) As Boolean
Dim nm As String, cur As Object, live As SldWorks.Feature
Dim uncertain As Boolean
DiscardProbeSketch = False
On Error Resume Next
Err.Clear
nm = skFeat.Name
If Err.Number <> 0 Then Exit Function
If nm = "" Then Exit Function
Err.Clear
Set cur = swSketchMgr.ActiveSketch
If Err.Number <> 0 Then Exit Function
If Not cur Is Nothing Then
Err.Clear
swSketchMgr.InsertSketch True
If Err.Number <> 0 Then Exit Function
Err.Clear
Set cur = swSketchMgr.ActiveSketch
If Err.Number <> 0 Then Exit Function
If Not cur Is Nothing Then Exit Function
End If
Set live = FindFeatureByName(nm, uncertain)
If live Is Nothing Then
DiscardProbeSketch = Not uncertain
Exit Function
End If
Err.Clear
swDoc.ClearSelection2 True
If Err.Number <> 0 Then Exit Function
Err.Clear
If Not live.Select(False) Then Exit Function
Err.Clear
swDoc.EditDelete
If Err.Number <> 0 Then Exit Function
Err.Clear
Set live = FindFeatureByName(nm, uncertain)
DiscardProbeSketch = (live Is Nothing) And (Not uncertain)
End Function

' Close the sketch only if one is actually open: InsertSketch toggles, so a
' blind call would open a new sketch when none is active.
Sub CloseSketchIfOpen()
Dim sk As Object
On Error Resume Next
Set sk = swSketchMgr.ActiveSketch
If Not sk Is Nothing Then swSketchMgr.InsertSketch True
End Sub

' The first feature type names in the tree: the report names what the scan
' actually saw when plane selection fails.
Function TreeSummary() As String
Dim feat As SldWorks.Feature, s As String, planes As String, i As Long
On Error Resume Next
Set feat = swDoc.FirstFeature
Do While Not feat Is Nothing And i < 300
If InStr(1, feat.GetTypeName2(), "lane", vbTextCompare) > 0 Then
planes = planes & feat.GetTypeName2() & "/" & feat.Name & " "
End If
If i < 10 Then s = s & feat.GetTypeName2() & " "
i = i + 1
Set feat = feat.GetNextFeature
Loop
TreeSummary = Trim(Str(i)) & " features; plane-like: [" & Trim(planes) & "]; first: " & s
End Function

' Truncate the report so this run never inherits a previous run's lines.
Sub StartReport()
On Error Resume Next
Dim f As Integer
f = FreeFile
Open reportPath For Output As #f
Close #f
End Sub

' One line, one fresh handle: open, print, close. Nothing to leak,
' nothing to collide with, and a crash can never hide earlier lines.
Sub WriteLine(ByVal text As String)
On Error Resume Next
Dim f As Integer
f = FreeFile
Open reportPath For Append As #f
Print #f, text
Close #f
End Sub

Sub WriteStep(ByVal idx As Long, ByVal command As String, ByVal status As String, ByVal message As String)
On Error Resume Next
WriteLine "{""type"":""step"",""index"":" & Trim(Str(idx)) & ",""command"":""" & JsonStr(command) & """,""status"":""" & JsonStr(status) & """,""message"":""" & JsonStr(message) & """}"
End Sub


' Close exactly the document this macro created - never any other - and
' verify it by a live enumeration of open documents: before the close, the
' title must identify exactly our object among open documents (an empty
' title is refused); after it, no open document may answer to the title.
' A failed query proves nothing and leaves the run failed. The owner rule:
' runs leave no documents open.
Sub CloseOwnedDoc(ByRef closedOk As Boolean)
Dim exact As String
Dim d As Object
Dim t2 As String
Dim cnt As Long
Dim isOurs As Boolean
On Error Resume Next
closedOk = False
If swDoc Is Nothing Then
closedOk = True
Exit Sub
End If
Err.Clear
exact = swDoc.GetTitle
If Err.Number <> 0 Then Exit Sub
If Trim(exact) = "" Then Exit Sub
Err.Clear
Set d = swApp.GetFirstDocument
If Err.Number <> 0 Then Exit Sub
Do While Not d Is Nothing
t2 = d.GetTitle
If Err.Number <> 0 Then Exit Sub
If t2 = exact Then
cnt = cnt + 1
If d Is swDoc Then isOurs = True
End If
Err.Clear
Set d = d.GetNext
If Err.Number <> 0 Then Exit Sub
Loop
If cnt <> 1 Or Not isOurs Then Exit Sub
Err.Clear
swApp.CloseDoc exact
If Err.Number <> 0 Then Exit Sub
Err.Clear
Set d = swApp.GetFirstDocument
If Err.Number <> 0 Then Exit Sub
cnt = 0
Do While Not d Is Nothing
t2 = d.GetTitle
If Err.Number <> 0 Then Exit Sub
If t2 = exact Then cnt = cnt + 1
Err.Clear
Set d = d.GetNext
If Err.Number <> 0 Then Exit Sub
Loop
If cnt = 0 Then closedOk = True
End Sub

Function CloseMode() As String
Dim p As String, f As Integer, oneLine As String
Dim ok As Boolean
Dim e3 As Long
CloseMode = "unknown"
On Error Resume Next
p = Environ$("TEMP")
If p = "" Then Exit Function
p = p & "\craft-bridge-report-path.txt"
Err.Clear
f = FreeFile
Open p For Input As #f
If Err.Number <> 0 Then Exit Function
Err.Clear
Line Input #f, oneLine
ok = (Err.Number = 0)
Err.Clear
If ok Then Line Input #f, oneLine
ok = ok And (Err.Number = 0)
Err.Clear
If ok Then Line Input #f, oneLine
e3 = Err.Number
Close #f
If Not ok Then Exit Function
If e3 = 0 Then
If Trim(oneLine) = "close-after-run" Then CloseMode = "close" Else CloseMode = "unknown"
ElseIf e3 = 62 And ok Then
CloseMode = "keep"
End If
End Function

Function OwnedDocTitle() As String
On Error Resume Next
OwnedDocTitle = ""
If swDoc Is Nothing Then Exit Function
OwnedDocTitle = "" & swDoc.GetTitle
End Function
' Accept a probed origin plane and publish its adaptation map for sketch
' slot idx: the probe-sketch translation must vanish and the normal must
' be parallel to the source normal (either sign) - the map and side come
' from PublishMap's fail-closed validation. Every read is trapped; any
' refusal carries its reason.
Function AcceptAndPublish(ByVal idx As Long, ByVal which As String, ByRef reason As String) As Boolean
Dim tr As Object
Dim a As Variant
Dim uPx As Double
Dim uPy As Double
Dim uPz As Double
Dim vPx As Double
Dim vPy As Double
Dim vPz As Double
Dim nPx As Double
Dim nPy As Double
Dim nPz As Double
On Error GoTo AccFail
AcceptAndPublish = False
reason = ""
Select Case which
Case "XY"
uPx = 1#: uPy = 0#: uPz = 0#
vPx = 0#: vPy = 1#: vPz = 0#
nPx = 0#: nPy = 0#: nPz = 1#
Case "XZ"
uPx = 1#: uPy = 0#: uPz = 0#
vPx = 0#: vPy = 0#: vPz = -1#
nPx = 0#: nPy = 1#: nPz = 0#
Case "YZ"
uPx = 0#: uPy = 1#: uPz = 0#
vPx = 0#: vPy = 0#: vPz = 1#
nPx = 1#: nPy = 0#: nPz = 0#
Case Else
reason = "unknown source plane " & which
Exit Function
End Select
Set tr = swSketchMgr.ActiveSketch.ModelToSketchTransform
If tr Is Nothing Then
reason = "the transform is missing"
Exit Function
End If
a = tr.ArrayData
If Abs(a(9)) > 0.000001 Or Abs(a(10)) > 0.000001 Or Abs(a(11)) > 0.000001 Then
reason = "the probe sketch origin is " & Vec3Text(a(9), a(10), a(11)) & ", not the model origin"
Exit Function
End If
If Not PublishMap(idx, uPx, uPy, uPz, vPx, vPy, vPz, nPx, nPy, nPz, reason) Then Exit Function
AcceptAndPublish = True
Exit Function
AccFail:
reason = "the frame read failed: err " & Trim(Str(Err.Number)) & ": " & Err.Description
End Function

' Invalidate one sketch slot's map (sketch deletion or re-probe). The
' publication is transactional: nothing reads a map that is not valid.
Sub ClearMap(ByVal idx As Long)
gMapValid(idx) = False
gMapSide(idx) = 0
End Sub

' Runtime axis classification (frame adaptation): the SC u direction maps
' to sketch (s,t) as (gMap00, gMap01), the SC v direction as (gMap10,
' gMap11). For a signed-permutation map each lands axis-aligned: AxisClass
' returns 0 when it lands on the s axis, 1 on the t axis, and -1 when the
' map is not a permutation (bounded support: this seat only exhibits
' permutation frames). AxisSign is the sign of the landed component.
Function AxisClass(ByVal idx As Long, ByVal isHoriz As Boolean) As Long
Dim c0 As Double
Dim c1 As Double
If isHoriz Then
c0 = gMap00(idx)
c1 = gMap01(idx)
Else
c0 = gMap10(idx)
c1 = gMap11(idx)
End If
AxisClass = -1
If Abs(Abs(c0) - 1#) <= 0.000001 And Abs(c1) <= 0.000001 Then AxisClass = 0
If Abs(Abs(c1) - 1#) <= 0.000001 And Abs(c0) <= 0.000001 Then AxisClass = 1
End Function

Function AxisSign(ByVal idx As Long, ByVal isHoriz As Boolean, ByVal ax As Long) As Double
Dim c As Double
If isHoriz Then
If ax = 0 Then c = gMap00(idx) Else c = gMap01(idx)
Else
If ax = 0 Then c = gMap10(idx) Else c = gMap11(idx)
End If
AxisSign = 1#
If c < 0 Then AxisSign = -1#
End Function

' The dimension text position is MODEL space (Phase 0, owner-verified):
' convert a sketch (s,t) position through the stored frame to (X,Y,Z).
Function SketchToModelX(ByVal idx As Long, ByVal s As Double, ByVal t As Double) As Double
SketchToModelX = gFrame(idx, 9) + s * gFrame(idx, 0) + t * gFrame(idx, 3)
End Function

Function SketchToModelY(ByVal idx As Long, ByVal s As Double, ByVal t As Double) As Double
SketchToModelY = gFrame(idx, 10) + s * gFrame(idx, 1) + t * gFrame(idx, 4)
End Function

Function SketchToModelZ(ByVal idx As Long, ByVal s As Double, ByVal t As Double) As Double
SketchToModelZ = gFrame(idx, 11) + s * gFrame(idx, 2) + t * gFrame(idx, 5)
End Function

' Feature guards (batch boundary): extrude, revolve and primitive replay
' still assume the identity map on the source normal side - batches 2 and 3
' replace this with the direction truth table and primitive adaptation.
' Anything else is refused with a named reason and never reports created.
Function MapIsIdentity(ByVal idx As Long) As Boolean
MapIsIdentity = False
If Not gMapValid(idx) Then Exit Function
If gMapSide(idx) <> 1 Then Exit Function
If Abs(gMap00(idx) - 1#) > 0.000001 Then Exit Function
If Abs(gMap11(idx) - 1#) > 0.000001 Then Exit Function
If Abs(gMap01(idx)) > 0.000001 Then Exit Function
If Abs(gMap10(idx)) > 0.000001 Then Exit Function
MapIsIdentity = True
End Function

' Rebuild and stay in sketch edit (seat-proven 2026-11-16: EditRebuild3
' EXITS sketch edit - sketch API calls then silently do nothing). The
' rebuild is required before any behavioural readback of a constraint;
' re-entry is required before any further sketch API call.
Sub SolveSketch(ByVal nm As String)
Dim sk As Object
swDoc.EditRebuild3
On Error Resume Next
Set sk = swSketchMgr.ActiveSketch
If Not sk Is Nothing Then Exit Sub
Err.Clear
swDoc.Extension.SelectByID2 nm, "SKETCH", 0#, 0#, 0#, False, 0, Nothing, swSelectOption_e.swSelectOptionDefault
If Err.Number <> 0 Then Err.Raise vbObjectError + 529, "craft-bridge", "the sketch " & nm & " could not be selected for re-entry: err " & Trim(Str(Err.Number))
swSketchMgr.InsertSketch True
Set sk = swSketchMgr.ActiveSketch
If sk Is Nothing Then Err.Raise vbObjectError + 529, "craft-bridge", "sketch edit could not be re-entered for " & nm
End Sub

' The closed-context half of verification (F7): after closing, no sketch
' may be active. The geometry readback runs in both contexts - the seat
' pinned handle readback as identical in active and closed contexts.
Function NoSketchIsOpen() As Boolean
Dim sk As Object
On Error Resume Next
Err.Clear
Set sk = swSketchMgr.ActiveSketch
If Err.Number <> 0 Then Exit Function
NoSketchIsOpen = (sk Is Nothing)
End Function

' Frame adaptation map (owner decision 2026-11-13): each sketch step
' publishes its own 2x2 map after its probe validates the frame; features
' referencing an earlier sketch restore that sketch's state first. MapU/
' MapV express SC (u,v) in the sketch's own (s,t): s = u(u_P.u') + v(v_P.u'),
' t = u(u_P.v') + v(v_P.v'), as stored by PublishMap.
Function MapU(ByVal idx As Long, ByVal u As Double, ByVal v As Double) As Double
MapU = u * gMap00(idx) + v * gMap10(idx)
End Function

Function MapV(ByVal idx As Long, ByVal u As Double, ByVal v As Double) As Double
MapV = u * gMap01(idx) + v * gMap11(idx)
End Function

' Publish the map for sketch slot idx from the probed frame. Fail-closed
' and transactional: validity is cleared first, every read and conversion
' is trapped, values are computed into locals, and the map is stored only
' after the complete validation passes - the pinned 16-entry ArrayData
' shape, finite entries, scale ~ 1 (entry 12), unit axes, mutual
' orthogonality, and a right-handed 3D frame (u x v = n). A proper 3D frame
' may still give an improper 2D map when the normal opposes the source
' normal - that is supported and recorded in gMapSide. Tolerances: 1e-6.
Function PublishMap(ByVal idx As Long, ByVal uPx As Double, ByVal uPy As Double, ByVal uPz As Double, ByVal vPx As Double, ByVal vPy As Double, ByVal vPz As Double, ByVal nPx As Double, ByVal nPy As Double, ByVal nPz As Double, ByRef reason As String) As Boolean
Dim tr As Object
Dim a As Variant
Dim ux As Double
Dim uy As Double
Dim uz As Double
Dim vx As Double
Dim vy As Double
Dim vz As Double
Dim nx As Double
Dim ny As Double
Dim nz As Double
Dim sc As Double
Dim ub As Long
Dim i As Long
Dim x As Double
Dim m00 As Double
Dim m01 As Double
Dim m10 As Double
Dim m11 As Double
Dim dot As Double
Dim side As Long
PublishMap = False
reason = ""
gMapValid(idx) = False
On Error Resume Next
Err.Clear
Set tr = swSketchMgr.ActiveSketch.ModelToSketchTransform
If Err.Number <> 0 Then
reason = "the transform could not be read: err " & Trim(Str(Err.Number))
Exit Function
End If
If tr Is Nothing Then
reason = "the transform is missing"
Exit Function
End If
Err.Clear
a = tr.ArrayData
If Err.Number <> 0 Then
reason = "ArrayData could not be read: err " & Trim(Str(Err.Number))
Exit Function
End If
Err.Clear
ub = UBound(a)
If Err.Number <> 0 Then
reason = "ArrayData is not an array: err " & Trim(Str(Err.Number))
Exit Function
End If
If ub <> 15 Then
reason = "ArrayData has " & Trim(Str(ub + 1)) & " entries; the pinned shape is 16"
Exit Function
End If
For i = 0 To 15
Err.Clear
x = CDbl(a(i))
If Err.Number <> 0 Then
reason = "entry " & Trim(Str(i)) & " is not numeric: err " & Trim(Str(Err.Number))
Exit Function
End If
If x <> x Then
reason = "entry " & Trim(Str(i)) & " is not finite"
Exit Function
End If
If Abs(x) > 1E+100 Then
reason = "entry " & Trim(Str(i)) & " is not finite"
Exit Function
End If
Next i
' Arithmetic is trapped: an overflow must fail the publication, never skip
' a check and reach the store below.
On Error GoTo MapFail
ux = a(0)
uy = a(3)
uz = a(6)
vx = a(1)
vy = a(4)
vz = a(7)
nx = a(2)
ny = a(5)
nz = a(8)
sc = a(12)
If Abs(sc - 1#) > 0.000001 Then
reason = "scale is " & Trim(Str(sc)) & ", not 1"
Exit Function
End If
If Abs(Sqr(ux * ux + uy * uy + uz * uz) - 1#) > 0.000001 Then reason = "u is not unit": Exit Function
If Abs(Sqr(vx * vx + vy * vy + vz * vz) - 1#) > 0.000001 Then reason = "v is not unit": Exit Function
If Abs(Sqr(nx * nx + ny * ny + nz * nz) - 1#) > 0.000001 Then reason = "n is not unit": Exit Function
If Abs(ux * vx + uy * vy + uz * vz) > 0.000001 Then reason = "u and v are not orthogonal": Exit Function
If Abs(ux * nx + uy * ny + uz * nz) > 0.000001 Then reason = "u and n are not orthogonal": Exit Function
If Abs(vx * nx + vy * ny + vz * nz) > 0.000001 Then reason = "v and n are not orthogonal": Exit Function
If Abs((uy * vz - uz * vy) - nx) > 0.000001 Then reason = "u x v does not equal n (x) - the 3D frame is not right-handed": Exit Function
If Abs((uz * vx - ux * vz) - ny) > 0.000001 Then reason = "u x v does not equal n (y) - the 3D frame is not right-handed": Exit Function
If Abs((ux * vy - uy * vx) - nz) > 0.000001 Then reason = "u x v does not equal n (z) - the 3D frame is not right-handed": Exit Function
m00 = uPx * ux + uPy * uy + uPz * uz
m10 = vPx * ux + vPy * uy + vPz * uz
m01 = uPx * vx + uPy * vy + uPz * vz
m11 = vPx * vx + vPy * vy + vPz * vz
dot = nx * nPx + ny * nPy + nz * nPz
If Abs(dot) < 0.999999 Then
If Abs(dot) <= 0.000001 Then
reason = "the normal is perpendicular to the source normal"
Else
reason = "the normal is only " & Trim(Str(dot)) & " parallel to the source normal"
End If
Exit Function
End If
side = 1
If dot < 0 Then side = -1
' Publish only now: nothing above has touched persistent state.
gMap00(idx) = m00
gMap10(idx) = m10
gMap01(idx) = m01
gMap11(idx) = m11
gMapSide(idx) = side
gFrame(idx, 0) = ux
gFrame(idx, 1) = uy
gFrame(idx, 2) = uz
gFrame(idx, 3) = vx
gFrame(idx, 4) = vy
gFrame(idx, 5) = vz
gFrame(idx, 6) = nx
gFrame(idx, 7) = ny
gFrame(idx, 8) = nz
gFrame(idx, 9) = a(9)
gFrame(idx, 10) = a(10)
gFrame(idx, 11) = a(11)
gMapValid(idx) = True
PublishMap = True
Exit Function
MapFail:
reason = "the frame computation failed: err " & Trim(Str(Err.Number)) & ": " & Err.Description
End Function

' The report path travels in a one-line file under the TEMP directory that
' the host rewrites before every run: preferred over CRAFT_BRIDGE_REPORT,
' because the macro runs inside the SolidWorks process, which may be an
' instance that started long ago with a stale environment. The environment
' variable is only the fallback for when the path file is missing or blank.
Function ReportPathFromHost() As String
Dim p As String, f As Integer, oneLine As String
Dim got As Boolean
ReportPathFromHost = ""
On Error Resume Next
p = Environ$("TEMP")
If p <> "" Then
p = p & "\craft-bridge-report-path.txt"
Err.Clear
f = FreeFile
Open p For Input As #f
If Err.Number = 0 Then
Err.Clear
Line Input #f, oneLine
got = (Err.Number = 0)
Err.Clear
Close #f
If got Then
oneLine = Trim(oneLine)
If oneLine <> "" Then
ReportPathFromHost = oneLine
Exit Function
End If
End If
End If
Err.Clear
End If
ReportPathFromHost = Trim(Environ$("CRAFT_BRIDGE_REPORT"))
End Function

' The directory of the macro (its sidecar snapshots live there): the
' second line of the host's path file.
Function MacroDirFromHost() As String
Dim p As String, f As Integer, oneLine As String
p = Environ$("TEMP")
If p = "" Then Exit Function
p = p & "\craft-bridge-report-path.txt"
Err.Clear
On Error Resume Next
f = FreeFile
Open p For Input As #f
If Err.Number = 0 Then
Line Input #f, oneLine
Line Input #f, oneLine
Close #f
If Err.Number = 0 Then MacroDirFromHost = Trim(oneLine)
End If
End Function
' JSON string escaping for the report file only.
Function JsonStr(ByVal s As String) As String
Dim t As String
t = Replace(s, "\", "\\")
t = Replace(t, """", "\""")
t = Replace(t, vbCrLf, "\n")
t = Replace(t, vbCr, "\n")
t = Replace(t, vbLf, "\n")
t = Replace(t, vbTab, "\t")
JsonStr = t
End Function

' Add a global-variable equation and rebuild. The name is a global, the
' right-hand side is equation syntax. Globals are verified through the
' dimensions that reference them.
Function AddGlobalEquation(ByVal nm As String, ByVal rhs As String, ByVal expect As Double, ByVal evalScale As Double) As String
On Error GoTo EqFail
Dim eqMgr As Object
Dim eqText As String
Dim idx As Long
Set eqMgr = swDoc.GetEquationMgr
If eqMgr Is Nothing Then gMsg = "the equation manager is missing": AddGlobalEquation = "failed": Exit Function
eqText = """" & nm & """=" & rhs
idx = eqMgr.Add(-1, eqText)
If idx < 0 Then gMsg = "equation failed: the equation was not accepted": GoTo EqFail
swDoc.EditRebuild3

If eqMgr.Equation(idx) <> eqText Then gMsg = "equation failed: the stored equation reads back differently": GoTo EqFail
If evalScale <= 0 Then gMsg = "equation failed: the evaluator unit semantics are not established for this parameter": GoTo EqFail
If Abs(eqMgr.Value(idx) - expect * evalScale) > 0.001 Then gMsg = "equation failed: the equation value does not match its written right-hand side": GoTo EqFail
gMsg = "equation " & eqText
AddGlobalEquation = "created"
Exit Function
EqFail:
If Err.Number <> 0 Then gMsg = "equation failed: " & Err.Description
AddGlobalEquation = "failed"
End Function

' Add an equation driving a dimension and verify it evaluated: the
' dimension name is captured at runtime, the value must match the
' expectation after a rebuild. Never presence alone.
Function AddDimEquation(ByVal dm As SldWorks.Dimension, ByVal rhs As String, ByVal expect As Double, ByVal slot As Long, ByVal signVal As Double) As Boolean
On Error GoTo EqFail
Dim eqMgr As Object
Dim eqText As String
Dim idx As Long
Set eqMgr = swDoc.GetEquationMgr
If eqMgr Is Nothing Then gMsg = "the equation manager is missing": GoTo EqFail
If signVal < 0 Then
eqText = """" & dm.Name & """=-1 * (" & rhs & ")"
Else
eqText = """" & dm.Name & """=" & rhs
End If
idx = eqMgr.Add(-1, eqText)
If idx < 0 Then gMsg = "the dimension equation was not accepted": GoTo EqFail
swDoc.EditRebuild3
If Abs(dm.SystemValue - expect) > 0.000001 Then gMsg = "the driven value does not match": GoTo EqFail

If eqMgr.Equation(idx) <> eqText Then gMsg = "the stored equation reads back differently": GoTo EqFail
If slot >= 0 Then regName(slot) = dm.Name
If slot >= 0 Then regSign(slot) = signVal
AddDimEquation = True
Exit Function
EqFail:
If Err.Number <> 0 Then gMsg = "err " & Trim(Str(Err.Number)) & ": " & Err.Description
AddDimEquation = False
End Function
