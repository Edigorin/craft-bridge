' craft-bridge compatibility checkpoint - minimal.swb
' Hand-written and reviewed line by line. It proves on one seat: .swb syntax and
' entry point, fresh-part creation from the default template, origin-plane
' selection, sketch creation, one relation and one dimension through the API,
' runtime reporting that survives hard failure, and the JSONL report contract.
' It creates nothing outside the part and writes nothing except the runtime
' report.
'
' Report plumbing: every line opens its own fresh handle (FreeFile), appends,
' and closes - no state, so "File already open" is impossible by construction
' and a crash can never hide earlier lines. The path comes from the
' CRAFT_BRIDGE_REPORT environment variable or from the one-line path file the
' host leaves in %TEMP% (the macro runs inside the SolidWorks process, which
' may predate the variable).
'
' Units: the SolidWorks API always takes metres (and radians). Every number
' below is therefore in metres.

Option Explicit

Dim swApp As SldWorks.SldWorks
Dim swDoc As SldWorks.ModelDoc2
Dim swSketchMgr As SketchManager
Dim reportPath As String
Dim gProbeLog As String

Sub main()
    Dim template As String
    Dim ok As Boolean
    Dim ln As SketchSegment
    Dim dp As SldWorks.Dimension
    Dim dd As SldWorks.DisplayDimension
    Dim stepIdx As Long
    stepIdx = -1
    On Error GoTo Fail

    ' ---- report setup (before any model mutation) ----
    reportPath = ReportPathFromHost()
    If reportPath = "" Then Err.Raise vbObjectError + 513, "minimal.swb", "no report path: CRAFT_BRIDGE_REPORT is unset and no path file exists in TEMP"
    StartReport
    WriteLine "{""type"":""header"",""macro"":""compat-check/minimal.swb"",""bridge_version"":""0.1.0""}"

    ' ---- step 0: fresh part from the default template ----
    stepIdx = 0
    Set swApp = Application.SldWorks
    template = swApp.GetUserPreferenceStringValue(swUserPreferenceStringValue_e.swDefaultTemplatePart)
    If template = "" Then Err.Raise vbObjectError + 514, "minimal.swb", "no default part template is configured"
    Set swDoc = swApp.NewDocument(template, 0, 0, 0)
    If swDoc Is Nothing Then Err.Raise vbObjectError + 515, "minimal.swb", "NewDocument returned nothing"
    WriteStep stepIdx, "document.new", "created", "fresh part from the default template"

    ' ---- step 1: sketch on the Front plane with one line and one circle ----
    stepIdx = 1
    Set swSketchMgr = swDoc.SketchManager
    ok = OpenSketchOnPlane("XY")
    If Not ok Then Err.Raise vbObjectError + 516, "minimal.swb", "no origin plane carries the XY frame u=(1,0,0) v=(0,1,0) n=(0,0,1); probed: " & gProbeLog & "; tree scan saw: " & TreeSummary()
    Set ln = swSketchMgr.CreateLine(0#, 0#, 0#, 0.04, 0#, 0#)
    swSketchMgr.CreateCircleByRadius 0.02, 0.02, 0#, 0.005
    swDoc.ClearSelection2 True
    WriteStep stepIdx, "sketch.geometry", "created", "1 line, 1 circle (metres)"

    ' ---- step 2: one relation: the line is horizontal ----
    stepIdx = 2
    ok = ln.Select(False)
    If Not ok Then Err.Raise vbObjectError + 517, "minimal.swb", "could not select the line"
    swDoc.SketchAddConstraints "sgHorizontal"
    swDoc.ClearSelection2 True
    WriteStep stepIdx, "sketch.relation", "created", "sgHorizontal"

    ' ---- step 3: one driving dimension: the line is 40 mm long ----
    stepIdx = 3
    ok = ln.Select(False)
    If Not ok Then Err.Raise vbObjectError + 518, "minimal.swb", "could not select the line for dimensioning"
    Set dd = swDoc.AddDimension2(0.02, 0.01, 0#)
    If dd Is Nothing Then Err.Raise vbObjectError + 519, "minimal.swb", "the dimension was not created"
    Set dp = dd.GetDimension2(0)
    If dp Is Nothing Then Err.Raise vbObjectError + 519, "minimal.swb", "the dimension has no underlying dimension"
    dp.SystemValue = 0.04
    swDoc.ClearSelection2 True
    WriteStep stepIdx, "sketch.dimension", "created", "length = 0.04 m"

    ' ---- done ----
    swSketchMgr.InsertSketch True
    WriteLine "{""type"":""summary"",""status"":""ok""}"
    Exit Sub

Fail:
    ' Capture the error FIRST: executing an On Error statement resets Err.
    Dim errNum As Long, errMsg As String
    errNum = Err.Number
    errMsg = Err.Description
    On Error Resume Next
    If reportPath = "" Then reportPath = ReportPathFromHost()
    If reportPath <> "" Then
        WriteStep stepIdx, "macro", "failed", "err " & Trim(Str(errNum)) & ": " & errMsg
        WriteLine "{""type"":""summary"",""status"":""failed""}"
    End If
End Sub

' Truncate the report so this run never inherits a previous run's lines.
Sub StartReport()
    On Error Resume Next
    Dim f As Integer
    f = FreeFile
    Open reportPath For Output As #f
    Close #f
End Sub

' One line, one fresh handle: open, print, close. Nothing to leak, nothing
' to collide with.
Sub WriteLine(ByVal text As String)
    On Error Resume Next
    Dim f As Integer
    f = FreeFile
    Open reportPath For Append As #f
    Print #f, text
    Close #f
End Sub

Sub WriteStep(ByVal idx As Long, ByVal command As String, ByVal status As String, ByVal message As String)
    WriteLine "{""type"":""step"",""index"":" & Trim(Str(idx)) & ",""command"":""" & JsonStr(command) & """,""status"":""" & JsonStr(status) & """,""message"":""" & JsonStr(message) & """}"
End Sub

' The report path travels in the host's environment or in a one-line path file
' under %TEMP%, because the macro runs inside the SolidWorks process.
Function ReportPathFromHost() As String
    Dim p As String, f As Integer, oneLine As String
    p = Environ$("CRAFT_BRIDGE_REPORT")
    If p <> "" Then
        ReportPathFromHost = p
        Exit Function
    End If
    p = Environ$("TEMP")
    If p = "" Then Exit Function
    p = p & "\craft-bridge-report-path.txt"
    Err.Clear
    On Error Resume Next
    f = FreeFile
    Open p For Input As #f
    If Err.Number = 0 Then
        Line Input #f, oneLine
        Close #f
        If Err.Number = 0 Then ReportPathFromHost = Trim(oneLine)
    End If
End Function

' JSON string escaping. This is not VBA-literal escaping: it is only for the
' report file. Generated code strings are escaped separately by the generator.
Function JsonStr(ByVal s As String) As String
    Dim t As String
    t = Replace(s, "\", "\\")
    t = Replace(t, """", "\""")
    t = Replace(t, vbCrLf, "\n")
    t = Replace(t, vbCr, "\n")
    t = Replace(t, vbLf, "\n")
    t = Replace(t, vbTab, "\t")
    JsonStr = t
End Function

' The plane whose sketch frame exactly matches the SolidCraft frame for the
' requested plane: axes, signs, and the sketch origin at the model origin.
' Plane names and tree positions are per config (one seat maps Front to the
' ZY plane), so no name or position is trusted; and verbatim (u, v) replay
' only lands coordinates where they belong on the frame the recipe implies.
' Anything else is refused and fails closed - coordinates are never silently
' reinterpreted (docs/mapping.md, Orientation). The probe leaves the sketch
' open on success. On failure the probe sketch is closed, deleted as one
' owned feature, and the deletion is verified.
Function OpenSketchOnPlane(ByVal which As String) As Boolean
    Dim feat As SldWorks.Feature, skFeat As SldWorks.Feature, ok As Boolean
    Set feat = swDoc.FirstFeature
    Do While Not feat Is Nothing
        If InStr(1, feat.GetTypeName2(), "lane", vbTextCompare) > 0 Then
            ok = feat.Select(False)
            If ok Then
                swSketchMgr.InsertSketch True
                Set skFeat = swSketchMgr.ActiveSketch
                If skFeat Is Nothing Then
                    gProbeLog = gProbeLog & feat.Name & ": no sketch opened; "
                ElseIf SketchFrameIs(which) Then
                    OpenSketchOnPlane = True
                    Exit Function
                Else
                    gProbeLog = gProbeLog & feat.Name & ": " & FrameText() & "; "
                    If Not DiscardProbeSketch(skFeat) Then Err.Raise vbObjectError + 520, "minimal.swb", "the probe sketch could not be confirmed deleted; probed: " & gProbeLog
                End If
            End If
        End If
        Set feat = feat.GetNextFeature
    Loop
    OpenSketchOnPlane = False
End Function

' The sketch frame must equal the SolidCraft frame for the plane exactly:
' u and v along the named model axes (with the signs u x v gives for the
' normal), and the sketch origin at the model origin. The model-to-sketch
' transform is row-major with rows = model axes in sketch coordinates, so
' the sketch axes in model coordinates are its columns - the inverse
' transform of the sketch unit vectors: u = (a0, a3, a6),
' v = (a1, a4, a7), n = (a2, a5, a8) - and the translation
' (a9, a10, a11) is the model origin in sketch coordinates, which must
' vanish. Pinned against non-symmetric frames in tests/build_tests.rs.
Function SketchFrameIs(ByVal which As String) As Boolean
    Dim tr As Variant, a As Variant, ok As Boolean
    On Error Resume Next
    Set tr = swSketchMgr.ActiveSketch.ModelToSketchTransform
    If Err.Number <> 0 Then Exit Function
    a = tr.ArrayData
    If Abs(a(9)) > 0.000001 Or Abs(a(10)) > 0.000001 Or Abs(a(11)) > 0.000001 Then Exit Function
    Select Case which
        Case "XY"
            ok = VecIs(a(0), a(3), a(6), 1#, 0#, 0#) And VecIs(a(1), a(4), a(7), 0#, 1#, 0#) And VecIs(a(2), a(5), a(8), 0#, 0#, 1#)
        Case "XZ"
            ok = VecIs(a(0), a(3), a(6), 1#, 0#, 0#) And VecIs(a(1), a(4), a(7), 0#, 0#, 1#) And VecIs(a(2), a(5), a(8), 0#, -1#, 0#)
        Case "YZ"
            ok = VecIs(a(0), a(3), a(6), 0#, 1#, 0#) And VecIs(a(1), a(4), a(7), 0#, 0#, 1#) And VecIs(a(2), a(5), a(8), 1#, 0#, 0#)
    End Select
    SketchFrameIs = ok
End Function

' Direction equality with sign, on normalized vectors: the transform may
' carry a uniform scale, the axes must still be exactly the expected ones.
Function VecIs(ByVal ax As Double, ByVal ay As Double, ByVal az As Double, ByVal bx As Double, ByVal by As Double, ByVal bz As Double) As Boolean
    Dim L As Double
    L = Sqr(ax * ax + ay * ay + az * az)
    If Abs(L) < 0.000001 Then Exit Function
    VecIs = Abs(ax / L - bx) < 0.000001 And Abs(ay / L - by) < 0.000001 And Abs(az / L - bz) < 0.000001
End Function

' The active sketch's frame as report text: the fail-closed messages name
' exactly what each probed plane offered.
Function FrameText() As String
    Dim tr As Variant, a As Variant
    On Error Resume Next
    Set tr = swSketchMgr.ActiveSketch.ModelToSketchTransform
    If Err.Number <> 0 Then FrameText = "(no frame)": Exit Function
    a = tr.ArrayData
    FrameText = "u=(" & Vec3Text(a(0), a(3), a(6)) & ") v=(" & Vec3Text(a(1), a(4), a(7)) & ") n=(" & Vec3Text(a(2), a(5), a(8)) & ") o=(" & Vec3Text(a(9), a(10), a(11)) & ")"
End Function

Function Vec3Text(ByVal x As Double, ByVal y As Double, ByVal z As Double) As String
    Vec3Text = Trim(Str(x)) & "," & Trim(Str(y)) & "," & Trim(Str(z))
End Function

' A live feature-tree lookup by name. Returns the feature when a complete
' walk found it; returns Nothing with uncertain = False only when a
' complete walk proves it absent; uncertain = True whenever the walk or
' the name failed. Absence is never inferred from a failed query, and an
' empty name is never sent to any API.
Function FindFeatureByName(ByVal nm As String, ByRef uncertain As Boolean) As SldWorks.Feature
    Dim feat As SldWorks.Feature, fn As String
    Set FindFeatureByName = Nothing
    uncertain = True
    If nm = "" Then Exit Function
    On Error Resume Next
    Err.Clear
    Set feat = swDoc.FirstFeature
    Do While Not feat Is Nothing
        If Err.Number <> 0 Then Exit Function
        Err.Clear
        fn = feat.Name
        If Err.Number <> 0 Then Exit Function
        If fn = nm Then
            Set FindFeatureByName = feat
            uncertain = False
            Exit Function
        End If
        Err.Clear
        Set feat = feat.GetNextFeature
    Loop
    If Err.Number = 0 Then uncertain = False
End Function

' Close the probe sketch and delete exactly the feature that was created
' for it - never a blind EditDelete, never a stale-object test. The name
' is captured while the object is alive and validated; the close is
' confirmed; the delete runs from a clean selection of the one feature the
' live tree returns; and the deletion is verified the same way. Closing an
' empty sketch may already have removed it - that is a clean result. True
' = the probe sketch is proven gone; every uncertain state fails closed.
Function DiscardProbeSketch(ByVal skFeat As SldWorks.Feature) As Boolean
    Dim nm As String, cur As Object, live As SldWorks.Feature
    Dim uncertain As Boolean
    DiscardProbeSketch = False
    On Error Resume Next
    Err.Clear
    nm = skFeat.Name
    If Err.Number <> 0 Then Exit Function
    If nm = "" Then Exit Function
    Err.Clear
    Set cur = swSketchMgr.ActiveSketch
    If Err.Number <> 0 Then Exit Function
    If Not cur Is Nothing Then
        Err.Clear
        swSketchMgr.InsertSketch True
        If Err.Number <> 0 Then Exit Function
        Err.Clear
        Set cur = swSketchMgr.ActiveSketch
        If Err.Number <> 0 Then Exit Function
        If Not cur Is Nothing Then Exit Function
    End If
    Set live = FindFeatureByName(nm, uncertain)
    If live Is Nothing Then
        DiscardProbeSketch = Not uncertain
        Exit Function
    End If
    Err.Clear
    swDoc.ClearSelection2 True
    If Err.Number <> 0 Then Exit Function
    Err.Clear
    If Not live.Select(False) Then Exit Function
    Err.Clear
    swDoc.EditDelete
    If Err.Number <> 0 Then Exit Function
    Err.Clear
    Set live = FindFeatureByName(nm, uncertain)
    DiscardProbeSketch = (live Is Nothing) And (Not uncertain)
End Function

' Close the sketch only if one is actually open: InsertSketch toggles, so a
' blind call would open a new sketch when none is active.
Sub CloseSketchIfOpen()
    Dim sk As Object
    On Error Resume Next
    Set sk = swSketchMgr.ActiveSketch
    If Not sk Is Nothing Then swSketchMgr.InsertSketch True
End Sub

' The first feature type names in the tree: the report names what the scan
' actually saw when plane selection fails.
Function TreeSummary() As String
    Dim feat As SldWorks.Feature, s As String, planes As String, i As Long
    On Error Resume Next
    Set feat = swDoc.FirstFeature
    Do While Not feat Is Nothing And i < 300
        If InStr(1, feat.GetTypeName2(), "lane", vbTextCompare) > 0 Then
            planes = planes & feat.GetTypeName2() & "/" & feat.Name & " "
        End If
        If i < 10 Then s = s & feat.GetTypeName2() & " "
        i = i + 1
        Set feat = feat.GetNextFeature
    Loop
    TreeSummary = Trim(Str(i)) & " features; plane-like: [" & Trim(planes) & "]; first: " & s
End Function
