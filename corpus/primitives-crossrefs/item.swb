' Generated by craft-bridge 0.1.0 from "item.craftx" - review before running.
' Units: the SolidWorks API always takes metres and radians.
Option Explicit

Dim swApp As SldWorks.SldWorks
Dim swDoc As SldWorks.ModelDoc2
Dim swSketchMgr As SketchManager
Dim reportPath As String
Dim gMsg As String
Dim regName(0 To 2) As String
Dim feat2 As SldWorks.Feature
Dim feat3 As SldWorks.Feature
Dim skName1 As String
Dim pt1(0 To 7) As SldWorks.SketchPoint
Dim sl1(0 To 3) As SldWorks.SketchLine

Sub main()
    Dim template As String
    Dim ok As Boolean
    Dim st As String
    Dim stopModel As Boolean
    Dim stepIdx As Long
    stepIdx = -1
    On Error GoTo Fail

    ' ---- report setup (before any model mutation) ----
    reportPath = ReportPathFromHost()
    If reportPath = "" Then Err.Raise vbObjectError + 513, "craft-bridge", "no report path: CRAFT_BRIDGE_REPORT is unset and no path file exists in TEMP"
    StartReport
    WriteLine "{""type"":""header"",""macro"":""item.craftx"",""bridge_version"":""0.1.0""}"
    ' ---- step 0: parameters.add ----
    stepIdx = 0
    If Not stopModel Then
        st = AddGlobalEquation("width", "40mm", 0.04)
    Else
        st = "not-executed"
        gMsg = "after the first stopped step"
    End If
    WriteStep stepIdx, "parameters.add", st, gMsg
    If st = "failed" Then stopModel = True

    ' ---- step 1: timeline.add ----
    stepIdx = 1
    If Not stopModel Then
        st = BuildSketch1()
    Else
        st = "not-executed"
        gMsg = "after the first stopped step"
    End If
    WriteStep stepIdx, "timeline.add", st, gMsg
    If st = "failed" Then stopModel = True

    ' ---- step 2: timeline.add ----
    stepIdx = 2
    If Not stopModel Then
        st = BuildPrim2()
    Else
        st = "not-executed"
        gMsg = "after the first stopped step"
    End If
    WriteStep stepIdx, "timeline.add", st, gMsg
    If st = "failed" Then stopModel = True

    ' ---- step 3: timeline.add ----
    stepIdx = 3
    If Not stopModel Then
        st = BuildPrim3()
    Else
        st = "not-executed"
        gMsg = "after the first stopped step"
    End If
    WriteStep stepIdx, "timeline.add", st, gMsg
    If st = "failed" Then stopModel = True

    WriteLine "{""type"":""summary"",""status"":""ok""}"
    Exit Sub

Fail:
    ' Capture the error FIRST: executing On Error resets Err.
    Dim errNum As Long, errMsg As String
    errNum = Err.Number
    errMsg = Err.Description
    ' The report must survive failure: open it if needed, write what happened
    ' and the completion signal, then leave the model as it is.
    On Error Resume Next
    If reportPath = "" Then reportPath = ReportPathFromHost()
    If reportPath <> "" Then
        WriteStep stepIdx, "macro", "failed", "err " & Trim(Str(errNum)) & ": " & errMsg
        WriteLine "{""type"":""summary"",""status"":""failed""}"
    End If
End Sub

' Sketch step 1: "Profile"
Function BuildSketch1() As String
    On Error GoTo HardFail
    Dim ok As Boolean
    ok = SelectOriginPlane("XY")
    If Not ok Then gMsg = "could not select the XY plane": GoTo SketchFailed
    swSketchMgr.InsertSketch True
    skName1 = swSketchMgr.ActiveSketch.Name
    DrawGeometry1
    If Not Relations1() Then GoTo Degrade
    If Not Dims1() Then GoTo Degrade
    If Not VerifySketch1() Then GoTo Degrade
    swSketchMgr.InsertSketch True
    gMsg = "8 relations and 1 dimensions replayed"
    BuildSketch1 = "created"
    Exit Function

Degrade:
' Restore, do not merely delete relations: wipe the sketch contents,
' redraw at the stored coordinates, reapply driving dimensions, verify again.
CleanSketch1
    DrawGeometry1
    If Not Dims1() Then GoTo SketchFailed
    If Not VerifySketch1() Then GoTo SketchFailed
    swSketchMgr.InsertSketch True
    gMsg = "rebuilt as geometry plus driving dimensions"
    BuildSketch1 = "degraded"
    Exit Function

SketchFailed:
    On Error Resume Next
    swSketchMgr.InsertSketch True
    BuildSketch1 = "failed"
    Exit Function

HardFail:
    On Error Resume Next
    swSketchMgr.InsertSketch True
    gMsg = Err.Description
    BuildSketch1 = "failed"
End Function

Sub DrawGeometry1()
    Set sl1(0) = swSketchMgr.CreateLine(0.0, 0.0, 0#, 0.04, 0.0, 0#)
    Set pt1(0) = sl1(0).GetStartPoint
    Set pt1(1) = sl1(0).GetEndPoint
    Set sl1(1) = swSketchMgr.CreateLine(0.04, 0.0, 0#, 0.04, 0.02, 0#)
    Set pt1(2) = sl1(1).GetStartPoint
    Set pt1(3) = sl1(1).GetEndPoint
    Set sl1(2) = swSketchMgr.CreateLine(0.04, 0.02, 0#, 0.0, 0.02, 0#)
    Set pt1(4) = sl1(2).GetStartPoint
    Set pt1(5) = sl1(2).GetEndPoint
    Set sl1(3) = swSketchMgr.CreateLine(0.0, 0.02, 0#, 0.0, 0.0, 0#)
    Set pt1(6) = sl1(3).GetStartPoint
    Set pt1(7) = sl1(3).GetEndPoint
    swDoc.ClearSelection2 True
End Sub

Function Relations1() As Boolean
    On Error GoTo RelFail
    pt1(1).Select False
    pt1(2).Select True
    swDoc.SketchAddConstraints "sgCoincident"
    swDoc.ClearSelection2 True
    pt1(3).Select False
    pt1(4).Select True
    swDoc.SketchAddConstraints "sgCoincident"
    swDoc.ClearSelection2 True
    pt1(5).Select False
    pt1(6).Select True
    swDoc.SketchAddConstraints "sgCoincident"
    swDoc.ClearSelection2 True
    pt1(0).Select False
    pt1(7).Select True
    swDoc.SketchAddConstraints "sgCoincident"
    swDoc.ClearSelection2 True
    sl1(0).Select False
    swDoc.SketchAddConstraints "sgHorizontal"
    swDoc.ClearSelection2 True
    sl1(1).Select False
    swDoc.SketchAddConstraints "sgVertical"
    swDoc.ClearSelection2 True
    sl1(2).Select False
    swDoc.SketchAddConstraints "sgHorizontal"
    swDoc.ClearSelection2 True
    sl1(3).Select False
    swDoc.SketchAddConstraints "sgVertical"
    swDoc.ClearSelection2 True
    Relations1 = True
    Exit Function
RelFail:
    Relations1 = False
End Function

Function Dims1() As Boolean
    On Error GoTo DimFail
    Dim dd As SldWorks.DisplayDimension
    Dim dm As SldWorks.Dimension
    sl1(0).Select False
    Set dd = swDoc.AddDimension2(0.03, 0.01, 0#)
    If dd Is Nothing Then GoTo DimFail
    Set dm = dd.GetDimension2(0)
    If dm Is Nothing Then GoTo DimFail
    dm.SystemValue = 0.04
    If Not AddDimEquation(dm, """width""", 0.04, 0) Then GoTo DimFail
    swDoc.ClearSelection2 True
    Dims1 = True
    Exit Function
DimFail:
    Dims1 = False
End Function

Function VerifySketch1() As Boolean
    Const TOL As Double = 0.000001
    On Error GoTo VerifyFail
    If Abs(pt1(0).X - 0.0) > TOL Then GoTo VerifyFail
    If Abs(pt1(0).Y - 0.0) > TOL Then GoTo VerifyFail
    If Abs(pt1(1).X - 0.04) > TOL Then GoTo VerifyFail
    If Abs(pt1(1).Y - 0.0) > TOL Then GoTo VerifyFail
    If Abs(pt1(2).X - 0.04) > TOL Then GoTo VerifyFail
    If Abs(pt1(2).Y - 0.0) > TOL Then GoTo VerifyFail
    If Abs(pt1(3).X - 0.04) > TOL Then GoTo VerifyFail
    If Abs(pt1(3).Y - 0.02) > TOL Then GoTo VerifyFail
    If Abs(pt1(4).X - 0.04) > TOL Then GoTo VerifyFail
    If Abs(pt1(4).Y - 0.02) > TOL Then GoTo VerifyFail
    If Abs(pt1(5).X - 0.0) > TOL Then GoTo VerifyFail
    If Abs(pt1(5).Y - 0.02) > TOL Then GoTo VerifyFail
    If Abs(pt1(6).X - 0.0) > TOL Then GoTo VerifyFail
    If Abs(pt1(6).Y - 0.02) > TOL Then GoTo VerifyFail
    If Abs(pt1(7).X - 0.0) > TOL Then GoTo VerifyFail
    If Abs(pt1(7).Y - 0.0) > TOL Then GoTo VerifyFail
    VerifySketch1 = True
    Exit Function
VerifyFail:
    VerifySketch1 = False
End Function

Sub CleanSketch1()
    Dim anySel As Boolean
    If Not pt1(0) Is Nothing Then
        pt1(0).Select False
        anySel = True
    End If
    swDoc.EditDelete
    swDoc.ClearSelection2 True
End Sub

' Primitive step 2: "Block"
Function BuildPrim2() As String
    On Error GoTo HardFail
    Dim ok As Boolean
    Dim feat As SldWorks.Feature
    Dim dm As SldWorks.Dimension
    Dim dd As SldWorks.DisplayDimension
    Dim seg As Variant
    Dim sl As SldWorks.SketchLine
    Dim ci As SldWorks.SketchCircle
    ok = SelectOriginPlane("XY")
    If Not ok Then gMsg = "could not select the Front plane": GoTo ExFail
    swSketchMgr.InsertSketch True
    seg = swSketchMgr.CreateCornerRectangle(0.0, 0.0, 0#, 0.08, 0.02, 0#)
    Set sl = seg(0)
    sl.Select False
    Set dd = swDoc.AddDimension2(0#, 0#, 0#)
    If dd Is Nothing Then GoTo ExFail
    Set dm = dd.GetDimension2(0)
    If dm Is Nothing Then GoTo ExFail
    If Abs(dm.SystemValue - 0.08) > 0.000001 Then gMsg = "the box length does not match": GoTo ExFail
    If regName(0) = "" Then GoTo ExFail
    If Not AddDimEquation(dm, ("""" & regName(0) & """) & " * 2", 0.08, 1) Then gMsg = "the box length equation did not evaluate": GoTo ExFail
    swDoc.ClearSelection2 True
    Set sl = seg(1)
    sl.Select False
    Set dd = swDoc.AddDimension2(0#, 0#, 0#)
    If dd Is Nothing Then GoTo ExFail
    Set dm = dd.GetDimension2(0)
    If dm Is Nothing Then GoTo ExFail
    If Abs(dm.SystemValue - 0.02) > 0.000001 Then gMsg = "the box width does not match": GoTo ExFail
    swDoc.ClearSelection2 True
    swSketchMgr.InsertSketch True
    ok = swDoc.Extension.SelectByID2(swSketchMgr.ActiveSketch.Name, "SKETCH", 0#, 0#, 0#, False, 0, Nothing, swSelectOption_e.swSelectOptionDefault)
    If Not ok Then gMsg = "could not select the primitive sketch": GoTo ExFail
    Set feat = swDoc.FeatureManager.FeatureExtrusion2(True, False, False, swEndConditions_e.swEndCondBlind, swEndConditions_e.swEndCondBlind, 0.01, 0#, False, False, False, False, 0#, 0#, False, False, False, False, True, True, True)
    If feat Is Nothing Then gMsg = "the primitive extrude was not created": GoTo ExFail
    Set dm = swDoc.Parameter("D1@" & feat.Name)
    If dm Is Nothing Then gMsg = "the primitive height dimension is missing": GoTo ExFail
    If Abs(dm.SystemValue - 0.01) > 0.000001 Then gMsg = "the primitive height does not match": GoTo ExFail
    gMsg = "primitive created"
    BuildPrim2 = "created"
    Exit Function

ExFail:
    BuildPrim2 = "failed"
    Exit Function

HardFail:
    gMsg = "err " & Trim(Str(Err.Number)) & ": " & Err.Description
    On Error Resume Next
    BuildPrim2 = "failed"
End Function

' Primitive step 3: "Peg"
Function BuildPrim3() As String
    On Error GoTo HardFail
    Dim ok As Boolean
    Dim feat As SldWorks.Feature
    Dim dm As SldWorks.Dimension
    Dim dd As SldWorks.DisplayDimension
    Dim seg As Variant
    Dim sl As SldWorks.SketchLine
    Dim ci As SldWorks.SketchCircle
    ok = SelectOriginPlane("XY")
    If Not ok Then gMsg = "could not select the Front plane": GoTo ExFail
    swSketchMgr.InsertSketch True
    Set ci = swSketchMgr.CreateCircleByRadius(0.0, 0.0, 0#, 0.04)
    ci.Select False
    Set dd = swDoc.AddDimension2(0#, 0#, 0#)
    If dd Is Nothing Then GoTo ExFail
    Set dm = dd.GetDimension2(0)
    If dm Is Nothing Then GoTo ExFail
    If Abs(dm.SystemValue - 0.04) > 0.000001 Then gMsg = "the cylinder radius does not match": GoTo ExFail
    If Not AddDimEquation(dm, """width""", 0.04, 2) Then gMsg = "the cylinder radius equation did not evaluate": GoTo ExFail
    swDoc.ClearSelection2 True
    swSketchMgr.InsertSketch True
    ok = swDoc.Extension.SelectByID2(swSketchMgr.ActiveSketch.Name, "SKETCH", 0#, 0#, 0#, False, 0, Nothing, swSelectOption_e.swSelectOptionDefault)
    If Not ok Then gMsg = "could not select the primitive sketch": GoTo ExFail
    Set feat = swDoc.FeatureManager.FeatureExtrusion2(True, False, False, swEndConditions_e.swEndCondBlind, swEndConditions_e.swEndCondBlind, 0.005, 0#, False, False, False, False, 0#, 0#, False, False, False, False, True, True, True)
    If feat Is Nothing Then gMsg = "the primitive extrude was not created": GoTo ExFail
    Set dm = swDoc.Parameter("D1@" & feat.Name)
    If dm Is Nothing Then gMsg = "the primitive height dimension is missing": GoTo ExFail
    If Abs(dm.SystemValue - 0.005) > 0.000001 Then gMsg = "the primitive height does not match": GoTo ExFail
    gMsg = "primitive created"
    BuildPrim3 = "created"
    Exit Function

ExFail:
    BuildPrim3 = "failed"
    Exit Function

HardFail:
    gMsg = "err " & Trim(Str(Err.Number)) & ": " & Err.Description
    On Error Resume Next
    BuildPrim3 = "failed"
End Function

' Write one step line and flush it to disk immediately.
' Origin planes by tree position (Front, Top, Right): plane names are
' localized, but RefPlane type names are not, and a fresh part always
' lists the origin planes first.
Function SelectOriginPlane(ByVal which As String) As Boolean
Dim feat As SldWorks.Feature, n As Long, want As Long
Select Case which
Case "XY": want = 0
Case "XZ": want = 1
Case "YZ": want = 2
Case Else: want = 0
End Select
Set feat = swDoc.FirstFeature
Do While Not feat Is Nothing
If feat.GetTypeName2() = "RefPlane" Then
If n = want Then
SelectOriginPlane = feat.Select(False)
Exit Function
End If
n = n + 1
End If
Set feat = feat.GetNextFeature
Loop
SelectOriginPlane = False
End Function
' Truncate the report so this run never inherits a previous run's lines.
Sub StartReport()
On Error Resume Next
Dim f As Integer
f = FreeFile
Open reportPath For Output As #f
Close #f
End Sub

' One line, one fresh handle: open, print, close. Nothing to leak,
' nothing to collide with, and a crash can never hide earlier lines.
Sub WriteLine(ByVal text As String)
On Error Resume Next
Dim f As Integer
f = FreeFile
Open reportPath For Append As #f
Print #f, text
Close #f
End Sub

Sub WriteStep(ByVal idx As Long, ByVal command As String, ByVal status As String, ByVal message As String)
On Error Resume Next
WriteLine "{""type"":""step"",""index"":" & Trim(Str(idx)) & ",""command"":""" & JsonStr(command) & """,""status"":""" & JsonStr(status) & """,""message"":""" & JsonStr(message) & """}"
End Sub


' The report path travels in the host's environment or in a one-line path
' file under %%TEMP%%, because the macro runs inside the SolidWorks process.
Function ReportPathFromHost() As String
Dim p As String, f As Integer, oneLine As String
p = Environ$("CRAFT_BRIDGE_REPORT")
If p <> "" Then
ReportPathFromHost = p
Exit Function
End If
p = Environ$("TEMP")
If p = "" Then Exit Function
p = p & "\craft-bridge-report-path.txt"
Err.Clear
On Error Resume Next
f = FreeFile
Open p For Input As #f
If Err.Number = 0 Then
Line Input #f, oneLine
Close #f
If Err.Number = 0 Then ReportPathFromHost = Trim(oneLine)
End If
End Sub

' The directory of the macro (its sidecar snapshots live there): the
' second line of the host's path file.
Function MacroDirFromHost() As String
Dim p As String, f As Integer, oneLine As String
p = Environ$("TEMP")
If p = "" Then Exit Function
p = p & "\craft-bridge-report-path.txt"
Err.Clear
On Error Resume Next
f = FreeFile
Open p For Input As #f
If Err.Number = 0 Then
Line Input #f, oneLine
Line Input #f, oneLine
Close #f
If Err.Number = 0 Then MacroDirFromHost = Trim(oneLine)
End If
End Function
' JSON string escaping for the report file only.
Function JsonStr(ByVal s As String) As String
Dim t As String
t = Replace(s, "\", "\\")
t = Replace(t, """", "\"")
t = Replace(t, vbCrLf, "\n")
t = Replace(t, vbCr, "\n")
t = Replace(t, vbLf, "\n")
t = Replace(t, vbTab, "\t")
JsonStr = t
End Function

' Add a global-variable equation and rebuild. The name is a global, the
' right-hand side is equation syntax. Globals are verified through the
' dimensions that reference them.
Function AddGlobalEquation(ByVal nm As String, ByVal rhs As String, ByVal expect As Double) As String
On Error GoTo EqFail
Dim eqMgr As SldWorks.EquationMgr
Dim eqText As String
Set eqMgr = swDoc.GetEquationMgr
If eqMgr Is Nothing Then gMsg = "the equation manager is missing": AddGlobalEquation = "failed": Exit Function
eqText = """" & nm & """=" & rhs
eqMgr.Add2 -1, eqText
swDoc.EditRebuild3
gMsg = "equation " & eqText
AddGlobalEquation = "created"
Exit Function
EqFail:
gMsg = "equation failed: " & Err.Description
AddGlobalEquation = "failed"
End Function

' Add an equation driving a dimension and verify it evaluated: the
' dimension name is captured at runtime, the value must match the
' expectation after a rebuild. Never presence alone.
Function AddDimEquation(ByVal dm As SldWorks.Dimension, ByVal rhs As String, ByVal expect As Double, ByVal slot As Long) As Boolean
On Error GoTo EqFail
Dim eqMgr As SldWorks.EquationMgr
Dim eqText As String
Set eqMgr = swDoc.GetEquationMgr
If eqMgr Is Nothing Then GoTo EqFail
eqText = """" & dm.Name & """=" & rhs
eqMgr.Add2 -1, eqText
swDoc.EditRebuild3
If Abs(dm.SystemValue - expect) > 0.000001 Then GoTo EqFail
If slot >= 0 Then regName(slot) = dm.Name
             AddDimEquation = True
Exit Function
EqFail:
AddDimEquation = False
End Function
