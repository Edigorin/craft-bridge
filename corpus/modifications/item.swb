' Generated by craft-bridge 0.1.0 from "item.craftx" - review before running.
' Units: the SolidWorks API always takes metres and radians.
Option Explicit

Dim swApp As SldWorks.SldWorks
Dim swDoc As SldWorks.ModelDoc2
Dim swSketchMgr As SketchManager
Dim reportPath As String
Dim gMsg As String
Dim feat0 As SldWorks.Feature
Dim feat1 As SldWorks.Feature
Dim feat2 As SldWorks.Feature

Sub main()
    Dim template As String
    Dim ok As Boolean
    Dim st As String
    Dim stopModel As Boolean
    Dim stepIdx As Long
    stepIdx = -1
    On Error GoTo Fail

    ' ---- report setup (before any model mutation) ----
    reportPath = ReportPathFromHost()
    If reportPath = "" Then Err.Raise vbObjectError + 513, "craft-bridge", "no report path: CRAFT_BRIDGE_REPORT is unset and no path file exists in TEMP"
    Open reportPath For Output As #1
    Print #1, "{""type"":""header"",""macro"":""item.craftx"",""bridge_version"":""0.1.0""}"
    FlushReport

    ' ---- step 0: timeline.add ----
    stepIdx = 0
    If Not stopModel Then
        st = BuildMod0()
    Else
        st = "not-executed"
        gMsg = "after the first stopped step"
    End If
    WriteStep stepIdx, "timeline.add", st, gMsg
    If st = "failed" Then stopModel = True

    ' ---- step 1: timeline.add ----
    stepIdx = 1
    If Not stopModel Then
        st = BuildMod1()
    Else
        st = "not-executed"
        gMsg = "after the first stopped step"
    End If
    WriteStep stepIdx, "timeline.add", st, gMsg
    If st = "failed" Then stopModel = True

    ' ---- step 2: timeline.add ----
    stepIdx = 2
    If Not stopModel Then
        st = BuildMod2()
    Else
        st = "not-executed"
        gMsg = "after the first stopped step"
    End If
    WriteStep stepIdx, "timeline.add", st, gMsg
    If st = "failed" Then stopModel = True

    Print #1, "{""type"":""summary"",""status"":""ok""}"
    Close #1
    Exit Sub

Fail:
    ' The report must survive failure: open it if needed, write what happened
    ' and the completion signal, then leave the model as it is.
    On Error Resume Next
    If reportPath = "" Then reportPath = ReportPathFromHost()
    If reportPath <> "" Then
        Open reportPath For Append As #1
        Print #1, "{""type"":""step"",""index"":" & Trim(Str(stepIdx)) & ",""command"":""macro"",""status"":""failed"",""message"":""" & JsonStr(Err.Description) & """}"
        Print #1, "{""type"":""summary"",""status"":""failed""}"
        Close #1
    End If
End Sub

' Modification step 0: "Round"
Function BuildMod0() As String
    On Error GoTo HardFail
    Dim ok As Boolean
    Dim feat As SldWorks.Feature
    Dim dm As SldWorks.Dimension
    Dim anySel As Boolean
    ok = swDoc.Extension.SelectByID2("", "EDGE", 0.01, 0.0, 0.0, False, 0, Nothing, swSelectOption_e.swSelectOptionDefault)
    If Not ok Then gMsg = "a EDGE pick did not land": GoTo ExFail
    ok = swDoc.Extension.SelectByID2("", "EDGE", 0.02, 0.0, 0.0, True, 0, Nothing, swSelectOption_e.swSelectOptionDefault)
    If Not ok Then gMsg = "a EDGE pick did not land": GoTo ExFail
    anySel = True
    ' feature call shape pending checkpoint verification
    Set feat = swDoc.FeatureFillet3(0.000002, True, 0, 0, 0)
    If feat Is Nothing Then gMsg = "the feature was not created": GoTo ExFail
    Set dm = swDoc.Parameter("D1@" & feat.Name)
    If dm Is Nothing Then gMsg = "the the fillet radius dimension is missing": GoTo ExFail
    If Abs(dm.SystemValue - 0.000002) > 0.000001 Then gMsg = "the the fillet radius does not match": GoTo ExFail
    swDoc.ClearSelection2 True
    gMsg = "created"
    BuildMod0 = "created"
    Exit Function

ExFail:
    BuildMod0 = "failed"
    Exit Function

HardFail:
    On Error Resume Next
    gMsg = Err.Description
    BuildMod0 = "failed"
End Function

' Modification step 1: "Hollow"
Function BuildMod1() As String
    On Error GoTo HardFail
    Dim ok As Boolean
    Dim feat As SldWorks.Feature
    Dim dm As SldWorks.Dimension
    Dim anySel As Boolean
    ok = swDoc.Extension.SelectByID2("", "FACE", 0.0, 0.0, 0.0, False, 0, Nothing, swSelectOption_e.swSelectOptionDefault)
    If Not ok Then gMsg = "a FACE pick did not land": GoTo ExFail
    anySel = True
    ' feature call shape pending checkpoint verification
    Set feat = swDoc.FeatureShell(0.0000015, False, 0#, False, False, False, 0#, 0#, 0#, 0#, 0#)
    If feat Is Nothing Then gMsg = "the feature was not created": GoTo ExFail
    Set dm = swDoc.Parameter("D1@" & feat.Name)
    If dm Is Nothing Then gMsg = "the the shell thickness dimension is missing": GoTo ExFail
    If Abs(dm.SystemValue - 0.0000015) > 0.000001 Then gMsg = "the the shell thickness does not match": GoTo ExFail
    swDoc.ClearSelection2 True
    gMsg = "created"
    BuildMod1 = "created"
    Exit Function

ExFail:
    BuildMod1 = "failed"
    Exit Function

HardFail:
    On Error Resume Next
    gMsg = Err.Description
    BuildMod1 = "failed"
End Function

' Modification step 2: "Bore"
Function BuildMod2() As String
    On Error GoTo HardFail
    Dim ok As Boolean
    Dim feat As SldWorks.Feature
    Dim dm As SldWorks.Dimension
    Dim anySel As Boolean
    ok = swDoc.Extension.SelectByID2("", "FACE", 0.005, 0.005, 0.0, False, 0, Nothing, swSelectOption_e.swSelectOptionDefault)
    If Not ok Then gMsg = "a FACE pick did not land": GoTo ExFail
    anySel = True
    ' feature call shape pending checkpoint verification
    Set feat = swDoc.SimpleHole2(True, False, False, swEndConditions_e.swEndCondBlind, 0.000004, 0.000008, 0#, 0#, False, False, False, False, 0#, 0#)
    If feat Is Nothing Then gMsg = "the feature was not created": GoTo ExFail
    Set dm = swDoc.Parameter("D1@" & feat.Name)
    If dm Is Nothing Then gMsg = "the the hole diameter dimension is missing": GoTo ExFail
    If Abs(dm.SystemValue - 0.000004) > 0.000001 Then gMsg = "the the hole diameter does not match": GoTo ExFail
    swDoc.ClearSelection2 True
    gMsg = "created"
    BuildMod2 = "created"
    Exit Function

ExFail:
    BuildMod2 = "failed"
    Exit Function

HardFail:
    On Error Resume Next
    gMsg = Err.Description
    BuildMod2 = "failed"
End Function

' Write one step line and flush it to disk immediately.
Sub WriteStep(ByVal idx As Long, ByVal command As String, ByVal status As String, ByVal message As String)
On Error Resume Next
Print #1, "{""type"":""step"",""index"":" & Trim(Str(idx)) & ",""command"":""" & JsonStr(command) & """,""status"":""" & JsonStr(status) & """,""message"":""" & JsonStr(message) & """}"
FlushReport
End Sub

' Close and reopen the report so the line just written reaches the disk.
Sub FlushReport()
On Error Resume Next
Close #1
Open reportPath For Append As #1
End Sub

' The report path travels in the host's environment or in a one-line path
' file under %%TEMP%%, because the macro runs inside the SolidWorks process.
Function ReportPathFromHost() As String
Dim p As String, f As Integer, oneLine As String
p = Environ$("CRAFT_BRIDGE_REPORT")
If p <> "" Then
ReportPathFromHost = p
Exit Function
End If
p = Environ$("TEMP")
If p = "" Then Exit Function
p = p & "\craft-bridge-report-path.txt"
Err.Clear
On Error Resume Next
f = FreeFile
Open p For Input As #f
If Err.Number = 0 Then
Line Input #f, oneLine
Close #f
If Err.Number = 0 Then ReportPathFromHost = Trim(oneLine)
End If
End Sub

' The directory of the macro (its sidecar snapshots live there): the
' second line of the host's path file.
Function MacroDirFromHost() As String
Dim p As String, f As Integer, oneLine As String
p = Environ$("TEMP")
If p = "" Then Exit Function
p = p & "\craft-bridge-report-path.txt"
Err.Clear
On Error Resume Next
f = FreeFile
Open p For Input As #f
If Err.Number = 0 Then
Line Input #f, oneLine
Line Input #f, oneLine
Close #f
If Err.Number = 0 Then MacroDirFromHost = Trim(oneLine)
End If
End Function
' JSON string escaping for the report file only.
Function JsonStr(ByVal s As String) As String
Dim t As String
t = Replace(s, "\", "\\")
t = Replace(t, """", "\"")
t = Replace(t, vbCrLf, "\n")
t = Replace(t, vbCr, "\n")
t = Replace(t, vbLf, "\n")
t = Replace(t, vbTab, "\t")
JsonStr = t
End Function

' Add a global-variable equation and rebuild. The name is a global, the
' right-hand side is equation syntax. Globals are verified through the
' dimensions that reference them.
Function AddGlobalEquation(ByVal nm As String, ByVal rhs As String, ByVal expect As Double) As String
On Error GoTo EqFail
Dim eqMgr As SldWorks.EquationMgr
Dim eqText As String
Set eqMgr = swDoc.GetEquationMgr
If eqMgr Is Nothing Then gMsg = "the equation manager is missing": AddGlobalEquation = "failed": Exit Function
eqText = """" & nm & """=" & rhs
eqMgr.Add2 -1, eqText
swDoc.EditRebuild3
gMsg = "equation " & eqText
AddGlobalEquation = "created"
Exit Function
EqFail:
gMsg = "equation failed: " & Err.Description
AddGlobalEquation = "failed"
End Function

' Add an equation driving a dimension and verify it evaluated: the
' dimension name is captured at runtime, the value must match the
' expectation after a rebuild. Never presence alone.
Function AddDimEquation(ByVal dm As SldWorks.Dimension, ByVal rhs As String, ByVal expect As Double, ByVal slot As Long) As Boolean
On Error GoTo EqFail
Dim eqMgr As SldWorks.EquationMgr
Dim eqText As String
Set eqMgr = swDoc.GetEquationMgr
If eqMgr Is Nothing Then GoTo EqFail
eqText = """" & dm.Name & """=" & rhs
eqMgr.Add2 -1, eqText
swDoc.EditRebuild3
If Abs(dm.SystemValue - expect) > 0.000001 Then GoTo EqFail
If slot >= 0 Then regName(slot) = dm.Name
             AddDimEquation = True
Exit Function
EqFail:
AddDimEquation = False
End Function
