' craft-bridge eqdiag - diagnostic probe: which EquationMgr and ModelDoc
' members does this seat's SolidWorks actually support at runtime? One
' report line per member attempt, with the numeric error captured
' immediately after the call. It creates nothing beyond a fresh part
' (plus diagnostic equations in it) and the runtime report. Diagnostic
' instrument, not a fidelity golden.
Option Explicit

Dim swApp As SldWorks.SldWorks
Dim swDoc As SldWorks.ModelDoc2
Dim reportPath As String

Sub main()
    Dim template As String
    On Error GoTo Fail
    reportPath = ReportPathFromHost()
    If reportPath = "" Then Err.Raise vbObjectError + 513, "eqdiag", "no report path"
    StartReport
    WriteLine "{""type"":""header"",""macro"":""eqdiag"",""bridge_version"":""0.1.0""}"
    Set swApp = Application.SldWorks
    template = swApp.GetUserPreferenceStringValue(swUserPreferenceStringValue_e.swDefaultTemplatePart)
    If template = "" Then Err.Raise vbObjectError + 514, "eqdiag", "no default part template"
    Set swDoc = swApp.NewDocument(template, 0, 0, 0)
    If swDoc Is Nothing Then Err.Raise vbObjectError + 515, "eqdiag", "no document"
    WriteLine "{""type"":""step"",""index"":-1,""command"":""document.new"",""status"":""created"",""message"":""fresh part from the default template""}"
    WriteLine ProbeLine("GetEquationMgr")
    WriteLine ProbeLine("Add")
    WriteLine ProbeLine("Count")
    WriteLine ProbeLine("Equation")
    WriteLine ProbeLine("Value")
    WriteLine ProbeLine("EditRebuild3")
    WriteLine ProbeLine("Add2-3arg")
    WriteLine ProbeLine("Add40mm")
    On Error Resume Next
    swApp.CloseDoc swDoc.GetTitle
    On Error GoTo Fail
    WriteLine "{""type"":""summary"",""status"":""ok""}"
    Exit Sub
Fail:
    Dim errNum As Long, errMsg As String
    errNum = Err.Number
    errMsg = Err.Description
    On Error Resume Next
    WriteLine "{""type"":""step"",""index"":-1,""command"":""eqdiag"",""status"":""failed"",""message"":""" & JsonStr("err " & Trim(Str(errNum)) & ": " & errMsg) & """}"
    WriteLine "{""type"":""summary"",""status"":""failed""}"
End Sub

' Try exactly one member and return one report line. The numeric error and
' its description are captured immediately after the call; a call that does
' not raise is reported as such - that is not proof of successful insertion.
Function ProbeLine(ByVal which As String) As String
    Dim eqMgr As Object
    Dim v As Variant
    Dim idx As Long
    Dim n As Long
    Dim d As String
    Dim detail As String
    On Error Resume Next
    detail = ""
    If which = "EditRebuild3" Then
        Err.Clear
        v = swDoc.EditRebuild3
        n = Err.Number
        d = Err.Description
        If n = 0 Then detail = "returned=" & Trim(Str(v))
        ProbeLine = LineFor(which, n, d, detail)
        Exit Function
    End If
    Err.Clear
    Set eqMgr = swDoc.GetEquationMgr
    n = Err.Number
    d = Err.Description
    If n <> 0 Then
        ProbeLine = LineFor(which, n, d, "while acquiring GetEquationMgr")
        Exit Function
    End If
    If eqMgr Is Nothing Then
        ProbeLine = LineFor(which, -1, "GetEquationMgr returned Nothing", "while acquiring GetEquationMgr")
        Exit Function
    End If
    Err.Clear
    Select Case which
        Case "GetEquationMgr"
            detail = "returned an object"
        Case "Add"
            idx = eqMgr.Add(-1, """G1""=0.001")
            n = Err.Number
            d = Err.Description
            If n = 0 Then detail = "returned index=" & Trim(Str(idx)) & " (call did not raise; insertion is unverified)"
        Case "Count"
            v = eqMgr.Count
            n = Err.Number
            d = Err.Description
            If n = 0 Then detail = "returned=" & Trim(Str(v))
        Case "Equation"
            v = eqMgr.Equation(0)
            n = Err.Number
            d = Err.Description
            If n = 0 Then detail = "returned text=" & CStr(v) & " (index 0 may be absent or pre-existing)"
        Case "Value"
            v = eqMgr.Value(0)
            n = Err.Number
            d = Err.Description
            If n = 0 Then detail = "returned value=" & Trim(Str(v)) & " (index 0 may be absent or pre-existing)"
        Case "Add2-3arg"
            idx = eqMgr.Add2(-1, """G2""=0.002", False)
            n = Err.Number
            d = Err.Description
            If n = 0 Then detail = "returned index=" & Trim(Str(idx)) & " (call did not raise; insertion is unverified)"
        Case "Add40mm"
            idx = eqMgr.Add(-1, """W1""=40mm")
            n = Err.Number
            d = Err.Description
            If n = 0 Then
                detail = "idx=" & Trim(Str(idx))
                Err.Clear
                v = eqMgr.Equation(idx)
                If Err.Number = 0 Then detail = detail & " text=" & CStr(v) Else detail = detail & " texterr=" & Err.Description
                Err.Clear
                v = eqMgr.Value(idx)
                If Err.Number = 0 Then detail = detail & " value=" & Trim(Str(v)) Else detail = detail & " valerr=" & Err.Description
            End If
    End Select
    ProbeLine = LineFor(which, n, d, detail)
End Function

Function LineFor(ByVal which As String, ByVal n As Long, ByVal d As String, ByVal detail As String) As String
    LineFor = "{""type"":""probe"",""member"":""" & JsonStr(which) & """,""err"":" & Trim(Str(n)) & ",""errdesc"":""" & JsonStr(d) & """,""detail"":""" & JsonStr(detail) & """}"
End Function

' The report path travels in a one-line file under the TEMP directory that
    ' the host rewrites before every run: preferred over CRAFT_BRIDGE_REPORT,
    ' because the macro runs inside the SolidWorks process, which may be an
    ' instance that started long ago with a stale environment. The environment
    ' variable is only the fallback for when the path file is missing or blank.
    Function ReportPathFromHost() As String
    Dim p As String, f As Integer, oneLine As String
    Dim got As Boolean
    ReportPathFromHost = ""
    On Error Resume Next
    p = Environ$("TEMP")
    If p <> "" Then
    p = p & "\craft-bridge-report-path.txt"
    Err.Clear
    f = FreeFile
    Open p For Input As #f
    If Err.Number = 0 Then
    Err.Clear
    Line Input #f, oneLine
    got = (Err.Number = 0)
    Err.Clear
    Close #f
    If got Then
    oneLine = Trim(oneLine)
    If oneLine <> "" Then
    ReportPathFromHost = oneLine
    Exit Function
    End If
    End If
    End If
    Err.Clear
    End If
    ReportPathFromHost = Trim(Environ$("CRAFT_BRIDGE_REPORT"))
    End Function

' Truncate the report so this run never inherits a previous run's lines.
Sub StartReport()
    On Error Resume Next
    Dim f As Integer
    f = FreeFile
    Open reportPath For Output As #f
    Close #f
End Sub

' One line, one fresh handle: open, print, close. Nothing to leak, nothing
' to collide with.
Sub WriteLine(ByVal text As String)
    On Error Resume Next
    Dim f As Integer
    f = FreeFile
    Open reportPath For Append As #f
    Print #f, text
    Close #f
End Sub

Sub WriteStep(ByVal idx As Long, ByVal command As String, ByVal status As String, ByVal message As String)
    WriteLine "{""type"":""step"",""index"":" & Trim(Str(idx)) & ",""command"":""" & JsonStr(command) & """,""status"":""" & JsonStr(status) & """,""message"":""" & JsonStr(message) & """}"
End Sub

' JSON string escaping. This is not VBA-literal escaping: it is only for the
' report file. Generated code strings are escaped separately by the generator.
Function JsonStr(ByVal s As String) As String
    Dim t As String
    t = Replace(s, "\", "\\")
    t = Replace(t, """", "\""")
    t = Replace(t, vbCrLf, "\n")
    t = Replace(t, vbCr, "\n")
    t = Replace(t, vbLf, "\n")
    t = Replace(t, vbTab, "\t")
    JsonStr = t
End Function
