' Generated by craft-bridge 0.1.0 from "item.craftx" - review before running.
' Units: the SolidWorks API always takes metres and radians.
Option Explicit

Dim swApp As SldWorks.SldWorks
Dim swDoc As SldWorks.ModelDoc2
Dim swSketchMgr As SketchManager
Dim reportPath As String
Dim gMsg As String
Dim gPlane As String
Dim gProbeLog As String
Dim gDoc As Object
Dim gFeatMgr As Object
Dim regName(0 To 1) As String
Dim feat3 As SldWorks.Feature
Dim skName2 As String
Dim pt2(0 To 7) As Object
Dim sl2(0 To 3) As Object

Sub main()
    Dim template As String
    Dim ok As Boolean
    Dim st As String
    Dim stopModel As Boolean
    Dim stepIdx As Long
    stepIdx = -1
    On Error GoTo Fail

    ' ---- report setup (before any model mutation) ----
    reportPath = ReportPathFromHost()
    If reportPath = "" Then Err.Raise vbObjectError + 513, "craft-bridge", "no report path: CRAFT_BRIDGE_REPORT is unset and no path file exists in TEMP"
    StartReport
    WriteLine "{""type"":""header"",""macro"":""item.craftx"",""bridge_version"":""0.1.0""}"

    ' ---- fresh part from the default template (before recipe step 0) ----
Set swApp = Application.SldWorks
template = swApp.GetUserPreferenceStringValue(swUserPreferenceStringValue_e.swDefaultTemplatePart)
If template = "" Then Err.Raise vbObjectError + 514, "craft-bridge", "no default part template is configured"
Set swDoc = swApp.NewDocument(template, 0, 0, 0)
If swDoc Is Nothing Then Err.Raise vbObjectError + 515, "craft-bridge", "NewDocument returned nothing"
Set swSketchMgr = swDoc.SketchManager
If swSketchMgr Is Nothing Then Err.Raise vbObjectError + 521, "craft-bridge", "the sketch manager is unavailable"
Set gFeatMgr = swDoc.FeatureManager
If gFeatMgr Is Nothing Then Err.Raise vbObjectError + 522, "craft-bridge", "the feature manager is unavailable"
Set gDoc = swDoc
WriteStep stepIdx, "document.new", "created", "fresh part from the default template"

    ' ---- step 0: document.units ----
    stepIdx = 0
    WriteStep stepIdx, "document.units", "not-executed", "units recorded (in); values replay in millimetres"

    ' ---- step 1: parameters.add ----
    stepIdx = 1
    If Not stopModel Then
        st = AddGlobalEquation("width", "40mm", 0.04)
    Else
        st = "not-executed"
        gMsg = "after the first stopped step"
    End If
    WriteStep stepIdx, "parameters.add", st, gMsg
    If st = "failed" Then stopModel = True

    ' ---- step 2: timeline.add ----
    stepIdx = 2
    If Not stopModel Then
        st = BuildSketch2()
    Else
        st = "not-executed"
        gMsg = "after the first stopped step"
    End If
    WriteStep stepIdx, "timeline.add", st, gMsg
    If st = "failed" Then stopModel = True

    ' ---- step 3: timeline.add ----
    stepIdx = 3
    If Not stopModel Then
        st = BuildExtrude3()
    Else
        st = "not-executed"
        gMsg = "after the first stopped step"
    End If
    WriteStep stepIdx, "timeline.add", st, gMsg
    If st = "failed" Then stopModel = True

    WriteLine "{""type"":""summary"",""status"":""ok""}"
    Exit Sub

Fail:
    ' Capture the error FIRST: executing On Error resets Err.
    Dim errNum As Long, errMsg As String
    errNum = Err.Number
    errMsg = Err.Description
    ' The report must survive failure: open it if needed, write what happened
    ' and the completion signal, then leave the model as it is.
    On Error Resume Next
    If reportPath = "" Then reportPath = ReportPathFromHost()
    If reportPath <> "" Then
        WriteStep stepIdx, "macro", "failed", "err " & Trim(Str(errNum)) & ": " & errMsg
        WriteLine "{""type"":""summary"",""status"":""failed""}"
    End If
End Sub

' Sketch step 2: "Profile"
Function BuildSketch2() As String
BuildSketch2 = "created"
End Function

Sub DrawGeometry2()
End Sub

Function Relations2() As Boolean
Relations2 = True
End Function

Function Dims2() As Boolean
Dims2 = True
End Function

Function VerifySketch2() As Boolean
VerifySketch2 = True
End Function

Sub CleanSketch2()
End Sub

' Extrude step 3: "Base"
Function BuildExtrude3() As String
    On Error GoTo HardFail
    Dim ok As Boolean
    Dim feat As SldWorks.Feature
    Dim dm As SldWorks.Dimension
    ok = swDoc.Extension.SelectByID2(skName2, "SKETCH", 0#, 0#, 0#, False, 0, Nothing, swSelectOption_e.swSelectOptionDefault)
    If Not ok Then gMsg = "could not select the sketch for the extrude": GoTo ExFail
    Set feat = gFeatMgr.FeatureExtrusion2(True, False, False, swEndConditions_e.swEndCondBlind, swEndConditions_e.swEndCondBlind, 0.012, 0#, False, False, False, False, 0#, 0#, False, False, False, False, True, True, True)
    If feat Is Nothing Then gMsg = "the extrude was not created": GoTo ExFail
    Set dm = swDoc.Parameter("D1@" & feat.Name)
    If dm Is Nothing Then gMsg = "the extrude dimension D1 is missing": GoTo ExFail
    If Abs(dm.SystemValue - 0.012) > 0.000001 Then gMsg = "the extrude dimension D1 does not match": GoTo ExFail
    Set feat3 = feat
    gMsg = "depth 0.012 m"
    BuildExtrude3 = "created"
    Exit Function

ExFail:
    BuildExtrude3 = "failed"
    Exit Function

HardFail:
    gMsg = "err " & Trim(Str(Err.Number)) & ": " & Err.Description
    On Error Resume Next
    BuildExtrude3 = "failed"
End Function

Sub ClearSlotsAll()
    Dim i As Long
    For i = 0 To UBound(regName)
        regName(i) = ""
    Next i
End Sub

' Write one step line and flush it to disk immediately.
' The plane whose sketch frame exactly matches the SolidCraft frame for the
' requested plane: axes, signs, and the sketch origin at the model origin.
' Plane names and tree positions are per config (one seat maps Front to the
' ZY plane), so no name or position is trusted; and verbatim (u, v) replay
' only lands coordinates where they belong on the frame the recipe implies.
' Anything else is refused and fails closed - coordinates are never
' silently reinterpreted (docs/mapping.md, Orientation). The probe leaves
' the sketch open on success. On failure the probe sketch is closed,
' deleted as one owned feature, and the deletion is verified.
Function OpenSketchOnPlane(ByVal which As String) As Boolean
Dim feat As SldWorks.Feature, skFeat As SldWorks.Feature, ok As Boolean
Set feat = swDoc.FirstFeature
Do While Not feat Is Nothing
If InStr(1, feat.GetTypeName2(), "lane", vbTextCompare) > 0 Then
ok = feat.Select(False)
If ok Then
swSketchMgr.InsertSketch True
Set skFeat = swSketchMgr.ActiveSketch
If skFeat Is Nothing Then
gProbeLog = gProbeLog & feat.Name & ": no sketch opened; "
ElseIf SketchFrameIs(which) Then
OpenSketchOnPlane = True
Exit Function
Else
gProbeLog = gProbeLog & feat.Name & ": " & FrameText() & "; "
If Not DiscardProbeSketch(skFeat) Then Err.Raise vbObjectError + 520, "craft-bridge", "the probe sketch could not be confirmed deleted; probed: " & gProbeLog
End If
End If
End If
Set feat = feat.GetNextFeature
Loop
OpenSketchOnPlane = False
End Function

' The plane feature's own runtime name (never assumed) for call shapes that
' need the plane selected as a FEATURE, like mirrors. The probe sketch is
' discarded: the mirror needs the plane, not a sketch.
Function PlaneNameFor(ByVal which As String) As String
Dim feat As SldWorks.Feature, skFeat As SldWorks.Feature, ok As Boolean
Set feat = swDoc.FirstFeature
Do While Not feat Is Nothing
If InStr(1, feat.GetTypeName2(), "lane", vbTextCompare) > 0 Then
ok = feat.Select(False)
If ok Then
swSketchMgr.InsertSketch True
Set skFeat = swSketchMgr.ActiveSketch
If skFeat Is Nothing Then
gProbeLog = gProbeLog & feat.Name & ": no sketch opened; "
ElseIf SketchFrameIs(which) Then
gProbeLog = gProbeLog & feat.Name & ": " & FrameText() & "; "
If Not DiscardProbeSketch(skFeat) Then Err.Raise vbObjectError + 520, "craft-bridge", "the probe sketch could not be confirmed deleted; probed: " & gProbeLog
PlaneNameFor = feat.Name
Exit Function
Else
gProbeLog = gProbeLog & feat.Name & ": " & FrameText() & "; "
If Not DiscardProbeSketch(skFeat) Then Err.Raise vbObjectError + 520, "craft-bridge", "the probe sketch could not be confirmed deleted; probed: " & gProbeLog
End If
End If
End If
Set feat = feat.GetNextFeature
Loop
End Function

' The sketch frame must equal the SolidCraft frame for the plane exactly:
' u and v exactly as SolidCraft defines them for the plane (its plane.rs
' 29-34): XZ has v = -Z, n = +Y. The sketch origin at the model origin. The model-to-sketch
' transform is row-major with rows = model axes in sketch coordinates, so
' the sketch axes in model coordinates are its columns - the inverse
' transform of the sketch unit vectors: u = (a0, a3, a6),
' v = (a1, a4, a7), n = (a2, a5, a8) - and the translation
' (a9, a10, a11) is the model origin in sketch coordinates, which must
' vanish. Pinned against non-symmetric frames in tests/build_tests.rs.
Function SketchFrameIs(ByVal which As String) As Boolean
Dim tr As Variant, a As Variant, ok As Boolean
On Error Resume Next
Set tr = swSketchMgr.ActiveSketch.ModelToSketchTransform
If Err.Number <> 0 Then Exit Function
a = tr.ArrayData
If Abs(a(9)) > 0.000001 Or Abs(a(10)) > 0.000001 Or Abs(a(11)) > 0.000001 Then Exit Function
Select Case which
Case "XY"
ok = VecIs(a(0), a(3), a(6), 1#, 0#, 0#) And VecIs(a(1), a(4), a(7), 0#, 1#, 0#) And VecIs(a(2), a(5), a(8), 0#, 0#, 1#)
Case "XZ"
ok = VecIs(a(0), a(3), a(6), 1#, 0#, 0#) And VecIs(a(1), a(4), a(7), 0#, 0#, -1#) And VecIs(a(2), a(5), a(8), 0#, 1#, 0#)
Case "YZ"
ok = VecIs(a(0), a(3), a(6), 0#, 1#, 0#) And VecIs(a(1), a(4), a(7), 0#, 0#, 1#) And VecIs(a(2), a(5), a(8), 1#, 0#, 0#)
End Select
SketchFrameIs = ok
End Function

' Direction equality with sign, on normalized vectors: the transform may
' carry a uniform scale, the axes must still be exactly the expected ones.
Function VecIs(ByVal ax As Double, ByVal ay As Double, ByVal az As Double, ByVal bx As Double, ByVal by As Double, ByVal bz As Double) As Boolean
Dim L As Double
L = Sqr(ax * ax + ay * ay + az * az)
If Abs(L) < 0.000001 Then Exit Function
VecIs = Abs(ax / L - bx) < 0.000001 And Abs(ay / L - by) < 0.000001 And Abs(az / L - bz) < 0.000001
End Function

' The active sketch's frame as report text: the fail-closed messages name
' exactly what each probed plane offered.
Function FrameText() As String
Dim tr As Variant, a As Variant
On Error Resume Next
Set tr = swSketchMgr.ActiveSketch.ModelToSketchTransform
If Err.Number <> 0 Then FrameText = "(no frame)": Exit Function
a = tr.ArrayData
FrameText = "u=(" & Vec3Text(a(0), a(3), a(6)) & ") v=(" & Vec3Text(a(1), a(4), a(7)) & ") n=(" & Vec3Text(a(2), a(5), a(8)) & ") o=(" & Vec3Text(a(9), a(10), a(11)) & ")"
End Function

Function Vec3Text(ByVal x As Double, ByVal y As Double, ByVal z As Double) As String
Vec3Text = Trim(Str(x)) & "," & Trim(Str(y)) & "," & Trim(Str(z))
End Function

' A live feature-tree lookup by name. Returns the feature when a complete
' walk found it; returns Nothing with uncertain = False only when a
' complete walk proves it absent; uncertain = True whenever the walk or
' the name failed. Absence is never inferred from a failed query, and an
' empty name is never sent to any API.
Function FindFeatureByName(ByVal nm As String, ByRef uncertain As Boolean) As SldWorks.Feature
Dim feat As SldWorks.Feature, fn As String
Set FindFeatureByName = Nothing
uncertain = True
If nm = "" Then Exit Function
On Error Resume Next
Err.Clear
Set feat = swDoc.FirstFeature
Do While Not feat Is Nothing
If Err.Number <> 0 Then Exit Function
Err.Clear
fn = feat.Name
If Err.Number <> 0 Then Exit Function
If fn = nm Then
Set FindFeatureByName = feat
uncertain = False
Exit Function
End If
Err.Clear
Set feat = feat.GetNextFeature
Loop
If Err.Number = 0 Then uncertain = False
End Function

' Close the probe sketch and delete exactly the feature that was created
' for it - never a blind EditDelete, never a stale-object test. The name
' is captured while the object is alive and validated; the close is
' confirmed; the delete runs from a clean selection of the one feature the
' live tree returns; and the deletion is verified the same way. Closing an
' empty sketch may already have removed it - that is a clean result. True
' = the probe sketch is proven gone; every uncertain state fails closed.
Function DiscardProbeSketch(ByVal skFeat As SldWorks.Feature) As Boolean
Dim nm As String, cur As Object, live As SldWorks.Feature
Dim uncertain As Boolean
DiscardProbeSketch = False
On Error Resume Next
Err.Clear
nm = skFeat.Name
If Err.Number <> 0 Then Exit Function
If nm = "" Then Exit Function
Err.Clear
Set cur = swSketchMgr.ActiveSketch
If Err.Number <> 0 Then Exit Function
If Not cur Is Nothing Then
Err.Clear
swSketchMgr.InsertSketch True
If Err.Number <> 0 Then Exit Function
Err.Clear
Set cur = swSketchMgr.ActiveSketch
If Err.Number <> 0 Then Exit Function
If Not cur Is Nothing Then Exit Function
End If
Set live = FindFeatureByName(nm, uncertain)
If live Is Nothing Then
DiscardProbeSketch = Not uncertain
Exit Function
End If
Err.Clear
swDoc.ClearSelection2 True
If Err.Number <> 0 Then Exit Function
Err.Clear
If Not live.Select(False) Then Exit Function
Err.Clear
swDoc.EditDelete
If Err.Number <> 0 Then Exit Function
Err.Clear
Set live = FindFeatureByName(nm, uncertain)
DiscardProbeSketch = (live Is Nothing) And (Not uncertain)
End Function

' Close the sketch only if one is actually open: InsertSketch toggles, so a
' blind call would open a new sketch when none is active.
Sub CloseSketchIfOpen()
Dim sk As Object
On Error Resume Next
Set sk = swSketchMgr.ActiveSketch
If Not sk Is Nothing Then swSketchMgr.InsertSketch True
End Sub

' The first feature type names in the tree: the report names what the scan
' actually saw when plane selection fails.
Function TreeSummary() As String
Dim feat As SldWorks.Feature, s As String, planes As String, i As Long
On Error Resume Next
Set feat = swDoc.FirstFeature
Do While Not feat Is Nothing And i < 300
If InStr(1, feat.GetTypeName2(), "lane", vbTextCompare) > 0 Then
planes = planes & feat.GetTypeName2() & "/" & feat.Name & " "
End If
If i < 10 Then s = s & feat.GetTypeName2() & " "
i = i + 1
Set feat = feat.GetNextFeature
Loop
TreeSummary = Trim(Str(i)) & " features; plane-like: [" & Trim(planes) & "]; first: " & s
End Function

' Truncate the report so this run never inherits a previous run's lines.
Sub StartReport()
On Error Resume Next
Dim f As Integer
f = FreeFile
Open reportPath For Output As #f
Close #f
End Sub

' One line, one fresh handle: open, print, close. Nothing to leak,
' nothing to collide with, and a crash can never hide earlier lines.
Sub WriteLine(ByVal text As String)
On Error Resume Next
Dim f As Integer
f = FreeFile
Open reportPath For Append As #f
Print #f, text
Close #f
End Sub

Sub WriteStep(ByVal idx As Long, ByVal command As String, ByVal status As String, ByVal message As String)
On Error Resume Next
WriteLine "{""type"":""step"",""index"":" & Trim(Str(idx)) & ",""command"":""" & JsonStr(command) & """,""status"":""" & JsonStr(status) & """,""message"":""" & JsonStr(message) & """}"
End Sub


' The report path travels in the host's environment or in a one-line path
' file under %%TEMP%%, because the macro runs inside the SolidWorks process.
Function ReportPathFromHost() As String
Dim p As String, f As Integer, oneLine As String
p = Environ$("CRAFT_BRIDGE_REPORT")
If p <> "" Then
ReportPathFromHost = p
Exit Function
End If
p = Environ$("TEMP")
If p = "" Then Exit Function
p = p & "\craft-bridge-report-path.txt"
Err.Clear
On Error Resume Next
f = FreeFile
Open p For Input As #f
If Err.Number = 0 Then
Line Input #f, oneLine
Close #f
If Err.Number = 0 Then ReportPathFromHost = Trim(oneLine)
End If
End Function

' The directory of the macro (its sidecar snapshots live there): the
' second line of the host's path file.
Function MacroDirFromHost() As String
Dim p As String, f As Integer, oneLine As String
p = Environ$("TEMP")
If p = "" Then Exit Function
p = p & "\craft-bridge-report-path.txt"
Err.Clear
On Error Resume Next
f = FreeFile
Open p For Input As #f
If Err.Number = 0 Then
Line Input #f, oneLine
Line Input #f, oneLine
Close #f
If Err.Number = 0 Then MacroDirFromHost = Trim(oneLine)
End If
End Function
' JSON string escaping for the report file only.
Function JsonStr(ByVal s As String) As String
Dim t As String
t = Replace(s, "\", "\\")
t = Replace(t, """", "\""")
t = Replace(t, vbCrLf, "\n")
t = Replace(t, vbCr, "\n")
t = Replace(t, vbLf, "\n")
t = Replace(t, vbTab, "\t")
JsonStr = t
End Function

' Add a global-variable equation and rebuild. The name is a global, the
' right-hand side is equation syntax. Globals are verified through the
' dimensions that reference them.
Function AddGlobalEquation(ByVal nm As String, ByVal rhs As String, ByVal expect As Double) As String
On Error GoTo EqFail
Dim eqMgr As Object
Dim eqText As String
Set eqMgr = swDoc.GetEquationMgr
If eqMgr Is Nothing Then gMsg = "the equation manager is missing": AddGlobalEquation = "failed": Exit Function
eqText = """" & nm & """=" & rhs
eqMgr.Add2 -1, eqText
swDoc.EditRebuild3
gMsg = "equation " & eqText
AddGlobalEquation = "created"
Exit Function
EqFail:
gMsg = "equation failed: " & Err.Description
AddGlobalEquation = "failed"
End Function

' Add an equation driving a dimension and verify it evaluated: the
' dimension name is captured at runtime, the value must match the
' expectation after a rebuild. Never presence alone.
Function AddDimEquation(ByVal dm As SldWorks.Dimension, ByVal rhs As String, ByVal expect As Double, ByVal slot As Long) As Boolean
On Error GoTo EqFail
Dim eqMgr As Object
Dim eqText As String
Set eqMgr = swDoc.GetEquationMgr
If eqMgr Is Nothing Then GoTo EqFail
eqText = """" & dm.Name & """=" & rhs
eqMgr.Add2 -1, eqText
swDoc.EditRebuild3
If Abs(dm.SystemValue - expect) > 0.000001 Then GoTo EqFail
If slot >= 0 Then regName(slot) = dm.Name
             AddDimEquation = True
Exit Function
EqFail:
If Err.Number <> 0 Then gMsg = "err " & Trim(Str(Err.Number)) & ": " & Err.Description Else gMsg = "the dimension equation could not be added"
AddDimEquation = False
End Function
