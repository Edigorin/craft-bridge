' craft-bridge probe-sketchspace - Phase 0 diagnostic: in which space do
' SolidWorks sketch-point readbacks and dimension text placements live?
' An asymmetric off-origin line at known sketch coordinates, read back in
' BOTH contexts, each context verified before any measurement borrows its
' name, with the full model-to-sketch transform (through scale) reported
' alongside. Every call captures its numeric error and description at its
' own stage; incomplete measurements are never labeled successful, and a
' failed setup or context check fails the run while cleanup still runs.
' Diagnostic instrument, not a fidelity golden.
Option Explicit

Dim swApp As SldWorks.SldWorks
Dim swDoc As SldWorks.ModelDoc2
Dim swSketchMgr As SketchManager
Dim reportPath As String
Dim gProbeLog As String

Sub main()
    Dim template As String
    Dim ln As SketchSegment
    Dim ok As Boolean
    Dim verified As Boolean
    Dim runFailed As Boolean
    Dim closedOk As Boolean
    Dim cleanupMode As String
    Dim errNum As Long
    Dim errMsg As String
    On Error GoTo Fail
    runFailed = False
    reportPath = ReportPathFromHost()
    If reportPath = "" Then Err.Raise vbObjectError + 513, "probe-sketchspace", "no report path"
    StartReport
    WriteLine "{""type"":""header"",""macro"":""probe-sketchspace"",""bridge_version"":""0.1.0""}"
    Set swApp = Application.SldWorks
    template = swApp.GetUserPreferenceStringValue(swUserPreferenceStringValue_e.swDefaultTemplatePart)
    If template = "" Then Err.Raise vbObjectError + 514, "probe-sketchspace", "no default part template"
    Set swDoc = swApp.NewDocument(template, 0, 0, 0)
    If swDoc Is Nothing Then Err.Raise vbObjectError + 515, "probe-sketchspace", "no document"
    Set swSketchMgr = swDoc.SketchManager
    WriteLine "{""type"":""step"",""index"":-1,""command"":""document.new"",""status"":""created"",""message"":""fresh part from the default template""}"
    If Not OpenFirstPlane() Then
        WriteLine "{""type"":""step"",""index"":0,""command"":""sketch.open"",""status"":""failed"",""message"":""" & JsonStr("the sketch could not be opened and verified; probed: " & gProbeLog) & """}"
        runFailed = True
        GoTo WrapUp
    End If
    WriteLine "{""type"":""step"",""index"":0,""command"":""sketch.open"",""status"":""created"",""message"":""" & JsonStr(gProbeLog) & """}"
    ReportContext "active", verified
    If Not verified Then
        WriteLine "{""type"":""step"",""index"":1,""command"":""context"",""status"":""failed"",""message"":""the active-sketch context is not verified; no measurement will be named after it""}"
        runFailed = True
        GoTo WrapUp
    End If
    ' Asymmetric and off-origin on purpose: any axis swap or reflection
    ' moves these points, so the readback space cannot hide.
    Err.Clear
    Set ln = swSketchMgr.CreateLine(0.013, 0.027, 0#, 0.041, -0.009, 0#)
    WriteLine LineDiag(ln)
    If ln Is Nothing Then
        WriteLine "{""type"":""step"",""index"":1,""command"":""draw"",""status"":""failed"",""message"":""CreateLine returned nothing; no measurement will be claimed""}"
        runFailed = True
        GoTo WrapUp
    End If
    WriteLine PointLine("active-predim", ln)
    WriteLine TransformLine()
    Err.Clear
    ok = ln.Select(False)
    If Not ok Then
        WriteLine "{""type"":""step"",""index"":2,""command"":""dimension"",""status"":""failed"",""message"":""line selection failed; no dimension placed and no later measurement claimed""}"
        runFailed = True
        GoTo WrapUp
    End If
    WriteLine DimLine()
    ' The active read AFTER the dimension: solver effects must not be
    ' confounded with the coordinate-context change.
    ReportContext "active", verified
    If Not verified Then
        WriteLine "{""type"":""step"",""index"":3,""command"":""context"",""status"":""failed"",""message"":""the active context is not verified before closing; the post-dimension read is refused""}"
        runFailed = True
        GoTo WrapUp
    End If
    WriteLine PointLine("active-postdim", ln)
    swSketchMgr.InsertSketch True
    ReportContext "closed", verified
    If Not verified Then
        WriteLine "{""type"":""step"",""index"":4,""command"":""context"",""status"":""failed"",""message"":""the closed context is not verified; the closed read is refused""}"
        runFailed = True
        GoTo WrapUp
    End If
    WriteLine PointLine("closed", ln)
WrapUp:
    cleanupMode = CloseMode()
    If cleanupMode = "close" Then
        CloseOwnedDoc closedOk
        If closedOk And Not runFailed Then
            WriteLine "{""type"":""summary"",""status"":""ok""}"
        Else
            If Not closedOk Then WriteStep 5, "close", "failed", "the owned document could not be confirmed closed"
            WriteLine "{""type"":""summary"",""status"":""failed""}"
        End If
    ElseIf cleanupMode = "keep" Then
        WriteStep 5, "owned-document", "kept-open", OwnedDocTitle()
        If runFailed Then
            WriteLine "{""type"":""summary"",""status"":""failed""}"
        Else
            WriteLine "{""type"":""summary"",""status"":""ok""}"
        End If
    Else
        WriteStep 5, "close-mode", "failed", "the cleanup mode could not be established"
        WriteLine "{""type"":""summary"",""status"":""failed""}"
    End If
    Exit Sub
Fail:
    errNum = Err.Number
    errMsg = Err.Description
    On Error Resume Next
    WriteLine "{""type"":""step"",""index"":-1,""command"":""probe"",""status"":""failed"",""message"":""" & JsonStr("err " & Trim(Str(errNum)) & ": " & errMsg) & """}"
    cleanupMode = CloseMode()
    If cleanupMode = "close" Then CloseOwnedDoc closedOk
    WriteLine "{""type"":""summary"",""status"":""failed""}"
End Sub

' Verify and report the claimed coordinate context; the caller must gate
' every context-named measurement on the result.
Sub ReportContext(ByVal ctx As String, ByRef verified As Boolean)
    Dim sk As Object
    Dim n As Long
    Dim d As String
    On Error Resume Next
    verified = False
    Err.Clear
    Set sk = swSketchMgr.ActiveSketch
    n = Err.Number
    d = Err.Description
    If n <> 0 Then
        WriteLine LineFor("context-" & ctx, n, d, "active-sketch query failed; context NOT verified")
        Exit Sub
    End If
    If ctx = "active" Then
        If sk Is Nothing Then
            WriteLine LineFor("context-active", -1, "no active sketch", "context NOT verified")
        Else
            verified = True
            WriteLine LineFor("context-active", 0, "", "verified: a sketch is active")
        End If
    Else
        If sk Is Nothing Then
            verified = True
            WriteLine LineFor("context-closed", 0, "", "verified: no sketch is active")
        Else
            WriteLine LineFor("context-closed", -1, "a sketch is still active", "context NOT verified")
        End If
    End If
End Sub

' What did CreateLine actually return, and which accessor form yields
' points? Every candidate is captured as variant-type evidence: a raw
' variant fetch reports its TypeName, the Set form reports its own error.
Function LineDiag(ByVal ln As Object) As String
    Dim v As Variant
    Dim sp As Object
    Dim n As Long
    Dim d As String
    Dim detail As String
    On Error Resume Next
    If ln Is Nothing Then
        LineDiag = LineFor("createline", -1, "returned Nothing", "the created object is Nothing")
        Exit Function
    End If
    Err.Clear
    detail = "type=" & TypeName(ln)
    If Err.Number <> 0 Then detail = "type err=" & Trim(Str(Err.Number))
    Err.Clear
    v = ln.Select(False)
    n = Err.Number
    d = Err.Description
    If n = 0 Then
        detail = detail & " | select result=" & CStr(v)
    Else
        detail = detail & " | select err=" & Trim(Str(n)) & " " & d
    End If
    Err.Clear
    v = ln.GetStartPoint
    n = Err.Number
    d = Err.Description
    If n <> 0 Then
        detail = detail & " | getstart-variant err=" & Trim(Str(n)) & " " & d
    Else
        detail = detail & " | getstart-variant type=" & TypeName(v)
    End If
    Err.Clear
    Set sp = ln.GetStartPoint
    n = Err.Number
    d = Err.Description
    If n <> 0 Then
        detail = detail & " | getstart-set err=" & Trim(Str(n)) & " " & d
    Else
        If sp Is Nothing Then
            detail = detail & " | getstart-set returned Nothing"
        Else
            detail = detail & " | getstart-set type=" & TypeName(sp)
        End If
    End If
    Err.Clear
    v = ln.StartPoint
    n = Err.Number
    d = Err.Description
    If n <> 0 Then
        detail = detail & " | startpoint-prop err=" & Trim(Str(n)) & " " & d
    Else
        detail = detail & " | startpoint-prop type=" & TypeName(v)
    End If
    LineDiag = LineFor("createline", 0, "", detail)
End Function

' All three point components, each captured and attributed to its own
' stage; nothing is labeled successful when a stage failed.
Function PointLine(ByVal ctx As String, ByVal ln As Object) As String
    Dim sp As Object
    Dim n1 As Long
    Dim d1 As String
    Dim sx As Double
    Dim sy As Double
    Dim sz As Double
    Dim detail As String
    On Error Resume Next
    Err.Clear
    Set sp = ln.GetStartPoint
    n1 = Err.Number
    d1 = Err.Description
    If n1 <> 0 Then
        PointLine = LineFor("point-" & ctx, n1, d1, "stage=start-get")
        Exit Function
    End If
    Err.Clear
    sx = sp.X
    n1 = Err.Number
    d1 = Err.Description
    If n1 <> 0 Then
        PointLine = LineFor("point-" & ctx, n1, d1, "stage=start-x")
        Exit Function
    End If
    Err.Clear
    sy = sp.Y
    n1 = Err.Number
    d1 = Err.Description
    If n1 <> 0 Then
        PointLine = LineFor("point-" & ctx, n1, d1, "stage=start-y")
        Exit Function
    End If
    Err.Clear
    sz = sp.Z
    n1 = Err.Number
    d1 = Err.Description
    If n1 <> 0 Then
        PointLine = LineFor("point-" & ctx, n1, d1, "stage=start-z")
        Exit Function
    End If
    detail = "start x=" & Trim(Str(sx)) & " y=" & Trim(Str(sy)) & " z=" & Trim(Str(sz))
    Err.Clear
    Set sp = ln.GetEndPoint
    n1 = Err.Number
    d1 = Err.Description
    If n1 <> 0 Then
        PointLine = LineFor("point-" & ctx, n1, d1, detail & " | stage=end-get")
        Exit Function
    End If
    Err.Clear
    sx = sp.X
    n1 = Err.Number
    d1 = Err.Description
    If n1 <> 0 Then
        PointLine = LineFor("point-" & ctx, n1, d1, detail & " | stage=end-x")
        Exit Function
    End If
    Err.Clear
    sy = sp.Y
    n1 = Err.Number
    d1 = Err.Description
    If n1 <> 0 Then
        PointLine = LineFor("point-" & ctx, n1, d1, detail & " | stage=end-y")
        Exit Function
    End If
    Err.Clear
    sz = sp.Z
    n1 = Err.Number
    d1 = Err.Description
    If n1 <> 0 Then
        PointLine = LineFor("point-" & ctx, n1, d1, detail & " | stage=end-z")
        Exit Function
    End If
    detail = detail & " | end x=" & Trim(Str(sx)) & " y=" & Trim(Str(sy)) & " z=" & Trim(Str(sz))
    PointLine = LineFor("point-" & ctx, 0, "", detail)
End Function

' The full model-to-sketch transform: every ArrayData entry including the
' scale at index 12, with bounds and indexing errors captured.
Function TransformLine() As String
    Dim tr As Object
    Dim a As Variant
    Dim n As Long
    Dim d As String
    Dim detail As String
    Dim i As Long
    Dim ub As Long
    On Error Resume Next
    Err.Clear
    Set tr = swSketchMgr.ActiveSketch.ModelToSketchTransform
    n = Err.Number
    d = Err.Description
    If n <> 0 Then
        TransformLine = LineFor("transform", n, d, "stage=get-transform")
        Exit Function
    End If
    Err.Clear
    a = tr.ArrayData
    n = Err.Number
    d = Err.Description
    If n <> 0 Then
        TransformLine = LineFor("transform", n, d, "stage=arraydata")
        Exit Function
    End If
    Err.Clear
    ub = UBound(a)
    n = Err.Number
    d = Err.Description
    If n <> 0 Then
        TransformLine = LineFor("transform", n, d, "stage=ubound")
        Exit Function
    End If
    detail = "len=" & Trim(Str(ub + 1)) & " entries="
    For i = 0 To ub
        Err.Clear
        detail = detail & Trim(Str(a(i)))
        If Err.Number <> 0 Then
            TransformLine = LineFor("transform", Err.Number, Err.Description, detail & " | stage=index-" & Trim(Str(i)))
            Exit Function
        End If
        If i < ub Then detail = detail & ","
    Next i
    TransformLine = LineFor("transform", 0, "", detail)
End Function

' The dimension: value and name through a separate dimension object; each
' text-position candidate records member access and then decoding as
' separate stages - an unsupported candidate is data, never a position.
Function DimLine() As String
    Dim dd As Object
    Dim dm As Object
    Dim n As Long
    Dim d As String
    Dim detail As String
    Dim v As Variant
    Dim na As Long
    Dim da As String
    On Error Resume Next
    Err.Clear
    Set dd = swDoc.AddDimension2(0.055, -0.035, 0#)
    n = Err.Number
    d = Err.Description
    If n <> 0 Then
        DimLine = LineFor("dimension", n, d, "stage=adddimension2")
        Exit Function
    End If
    Err.Clear
    Set dm = dd.GetDimension2(0)
    n = Err.Number
    d = Err.Description
    If n <> 0 Then
        DimLine = LineFor("dimension", n, d, "stage=getdimension2")
        Exit Function
    End If
    Err.Clear
    v = dm.SystemValue
    n = Err.Number
    d = Err.Description
    If n <> 0 Then
        DimLine = LineFor("dimension", n, d, "stage=systemvalue")
        Exit Function
    End If
    detail = "value=" & Trim(Str(v))
    Err.Clear
    v = dm.Name
    na = Err.Number
    da = Err.Description
    If na = 0 Then
        detail = detail & " | name=" & CStr(v)
    Else
        detail = detail & " | name-read err=" & Trim(Str(na)) & " " & da
    End If
    Err.Clear
    v = dd.GetTextPosition
    na = Err.Number
    da = Err.Description
    If na <> 0 Then
        detail = detail & " | textpos-get member err=" & Trim(Str(na)) & " " & da
    Else
        Err.Clear
        detail = detail & " | textpos-get=" & Trim(Str(v(0))) & "," & Trim(Str(v(1))) & "," & Trim(Str(v(2)))
        If Err.Number <> 0 Then detail = detail & " decode err=" & Trim(Str(Err.Number)) & " " & Err.Description
    End If
    Err.Clear
    v = dd.TextPosition
    na = Err.Number
    da = Err.Description
    If na <> 0 Then
        detail = detail & " | textpos-prop member err=" & Trim(Str(na)) & " " & da
    Else
        Err.Clear
        detail = detail & " | textpos-prop=" & Trim(Str(v(0))) & "," & Trim(Str(v(1))) & "," & Trim(Str(v(2)))
        If Err.Number <> 0 Then detail = detail & " decode err=" & Trim(Str(Err.Number)) & " " & Err.Description
    End If
    DimLine = LineFor("dimension", 0, "", detail)
End Function

Function LineFor(ByVal which As String, ByVal n As Long, ByVal d As String, ByVal detail As String) As String
    LineFor = "{""type"":""probe"",""member"":""" & JsonStr(which) & """,""err"":" & Trim(Str(n)) & ",""errdesc"":""" & JsonStr(d) & """,""detail"":""" & JsonStr(detail) & """}"
End Function

' Open the first plane-like feature and confirm an active sketch before
' claiming success. Sketch-opening success and frame evidence are reported
' separately: a frame read failure never rewrites an opened sketch into a
' failure, and never into a silent success either - it lands in the log.
Function OpenFirstPlane() As Boolean
    Dim feat As Object
    Dim nm As String
    Dim fname As String
    Dim sk As Object
    Dim n As Long
    Dim d As String
    Dim sel As Boolean
    On Error Resume Next
    OpenFirstPlane = False
    gProbeLog = ""
    Err.Clear
    Set feat = swDoc.FirstFeature
    n = Err.Number
    d = Err.Description
    If n <> 0 Then
        gProbeLog = gProbeLog & "stage=firstfeature err=" & Trim(Str(n)) & " " & d & "; "
        Exit Function
    End If
    Do While Not feat Is Nothing
        Err.Clear
        nm = feat.GetTypeName2()
        n = Err.Number
        d = Err.Description
        If n <> 0 Then
            gProbeLog = gProbeLog & "stage=typename err=" & Trim(Str(n)) & " " & d & "; "
            Exit Function
        End If
        If InStr(1, nm, "lane", vbTextCompare) > 0 Then
            ' The name is cached first, with its own capture: building an
            ' error message must never disturb the evidence it reports.
            Err.Clear
            fname = feat.Name
            n = Err.Number
            d = Err.Description
            If n <> 0 Then
                gProbeLog = gProbeLog & "stage=name err=" & Trim(Str(n)) & " " & d & "; "
                Exit Function
            End If
            Err.Clear
            sel = feat.Select(False)
            n = Err.Number
            d = Err.Description
            If n <> 0 Then
                gProbeLog = gProbeLog & fname & ": select err=" & Trim(Str(n)) & " " & d & "; "
                Exit Function
            End If
            If Not sel Then
                gProbeLog = gProbeLog & fname & ": select returned false; "
            Else
                Err.Clear
                swSketchMgr.InsertSketch True
                n = Err.Number
                d = Err.Description
                If n <> 0 Then
                    gProbeLog = gProbeLog & fname & ": insertsketch err=" & Trim(Str(n)) & " " & d & "; "
                    Exit Function
                End If
                Err.Clear
                Set sk = swSketchMgr.ActiveSketch
                n = Err.Number
                d = Err.Description
                If n <> 0 Then
                    gProbeLog = gProbeLog & fname & ": activesketch err=" & Trim(Str(n)) & " " & d & "; "
                    Exit Function
                End If
                If sk Is Nothing Then
                    gProbeLog = gProbeLog & fname & ": opened but no active sketch object; "
                    Exit Function
                End If
                gProbeLog = gProbeLog & fname & ": opened; frame " & FrameTextEx() & "; "
                OpenFirstPlane = True
                Exit Function
            End If
        End If
        Err.Clear
        Set feat = feat.GetNextFeature
        n = Err.Number
        d = Err.Description
        If n <> 0 Then
            gProbeLog = gProbeLog & "stage=nextfeature err=" & Trim(Str(n)) & " " & d & "; "
            Exit Function
        End If
    Loop
End Function

' Probe-local frame evidence with full capture and descriptions (the
' checkpoint helper does not capture indexing failures; this one reports
' them).
Function FrameTextEx() As String
    Dim tr As Object
    Dim a As Variant
    Dim n As Long
    Dim d As String
    On Error Resume Next
    Err.Clear
    Set tr = swSketchMgr.ActiveSketch.ModelToSketchTransform
    n = Err.Number
    d = Err.Description
    If n <> 0 Then
        FrameTextEx = "(frame unavailable: get err " & Trim(Str(n)) & " " & d & ")"
        Exit Function
    End If
    Err.Clear
    a = tr.ArrayData
    n = Err.Number
    d = Err.Description
    If n <> 0 Then
        FrameTextEx = "(frame unavailable: arraydata err " & Trim(Str(n)) & " " & d & ")"
        Exit Function
    End If
    Err.Clear
    FrameTextEx = "u=(" & Vec3Text(a(0), a(3), a(6)) & ") v=(" & Vec3Text(a(1), a(4), a(7)) & ") n=(" & Vec3Text(a(2), a(5), a(8)) & ") o=(" & Vec3Text(a(9), a(10), a(11)) & ")"
    n = Err.Number
    d = Err.Description
    If n <> 0 Then FrameTextEx = "(frame unavailable: index err " & Trim(Str(n)) & " " & d & ")"
End Function

Function Vec3Text(ByVal x As Double, ByVal y As Double, ByVal z As Double) As String
    Vec3Text = Trim(Str(x)) & "," & Trim(Str(y)) & "," & Trim(Str(z))
End Function

' The report path travels in a one-line file under the TEMP directory that
    ' the host rewrites before every run: preferred over CRAFT_BRIDGE_REPORT,
    ' because the macro runs inside the SolidWorks process, which may be an
    ' instance that started long ago with a stale environment. The environment
    ' variable is only the fallback for when the path file is missing or blank.
    Function ReportPathFromHost() As String
    Dim p As String, f As Integer, oneLine As String
    Dim got As Boolean
    ReportPathFromHost = ""
    On Error Resume Next
    p = Environ$("TEMP")
    If p <> "" Then
    p = p & "\craft-bridge-report-path.txt"
    Err.Clear
    f = FreeFile
    Open p For Input As #f
    If Err.Number = 0 Then
    Err.Clear
    Line Input #f, oneLine
    got = (Err.Number = 0)
    Err.Clear
    Close #f
    If got Then
    oneLine = Trim(oneLine)
    If oneLine <> "" Then
    ReportPathFromHost = oneLine
    Exit Function
    End If
    End If
    End If
    Err.Clear
    End If
    ReportPathFromHost = Trim(Environ$("CRAFT_BRIDGE_REPORT"))
    End Function

' Truncate the report so this run never inherits a previous run's lines.
Sub StartReport()
    On Error Resume Next
    Dim f As Integer
    f = FreeFile
    Open reportPath For Output As #f
    Close #f
End Sub

' One line, one fresh handle: open, print, close. Nothing to leak, nothing
' to collide with.
Sub WriteLine(ByVal text As String)
    On Error Resume Next
    Dim f As Integer
    f = FreeFile
    Open reportPath For Append As #f
    Print #f, text
    Close #f
End Sub

Sub WriteStep(ByVal idx As Long, ByVal command As String, ByVal status As String, ByVal message As String)
    WriteLine "{""type"":""step"",""index"":" & Trim(Str(idx)) & ",""command"":""" & JsonStr(command) & """,""status"":""" & JsonStr(status) & """,""message"":""" & JsonStr(message) & """}"
End Sub

' JSON string escaping. This is not VBA-literal escaping: it is only for the
' report file. Generated code strings are escaped separately by the generator.
Function JsonStr(ByVal s As String) As String
    Dim t As String
    t = Replace(s, "\", "\\")
    t = Replace(t, """", "\""")
    t = Replace(t, vbCrLf, "\n")
    t = Replace(t, vbCr, "\n")
    t = Replace(t, vbLf, "\n")
    t = Replace(t, vbTab, "\t")
    JsonStr = t
End Function

Sub CloseOwnedDoc(ByRef closedOk As Boolean)
    Dim exact As String
    Dim d As Object
    Dim t2 As String
    Dim cnt As Long
    Dim isOurs As Boolean
    On Error Resume Next
    closedOk = False
    If swDoc Is Nothing Then
        closedOk = True
        Exit Sub
    End If
    Err.Clear
    exact = swDoc.GetTitle
    If Err.Number <> 0 Then Exit Sub
    If Trim(exact) = "" Then Exit Sub
    Err.Clear
    Set d = swApp.GetFirstDocument
    If Err.Number <> 0 Then Exit Sub
    Do While Not d Is Nothing
        t2 = d.GetTitle
        If Err.Number <> 0 Then Exit Sub
        If t2 = exact Then
            cnt = cnt + 1
            If d Is swDoc Then isOurs = True
        End If
        Err.Clear
        Set d = d.GetNext
        If Err.Number <> 0 Then Exit Sub
    Loop
    If cnt <> 1 Or Not isOurs Then Exit Sub
    Err.Clear
    swApp.CloseDoc exact
    If Err.Number <> 0 Then Exit Sub
    Err.Clear
    Set d = swApp.GetFirstDocument
    If Err.Number <> 0 Then Exit Sub
    cnt = 0
    Do While Not d Is Nothing
        t2 = d.GetTitle
        If Err.Number <> 0 Then Exit Sub
        If t2 = exact Then cnt = cnt + 1
        Err.Clear
        Set d = d.GetNext
        If Err.Number <> 0 Then Exit Sub
    Loop
    If cnt = 0 Then closedOk = True
End Sub

Function CloseMode() As String
    Dim p As String, f As Integer, oneLine As String
    Dim ok As Boolean
    Dim e3 As Long
    CloseMode = "unknown"
    On Error Resume Next
    p = Environ$("TEMP")
    If p = "" Then Exit Function
    p = p & "\craft-bridge-report-path.txt"
    Err.Clear
    f = FreeFile
    Open p For Input As #f
    If Err.Number <> 0 Then Exit Function
    Err.Clear
    Line Input #f, oneLine
    ok = (Err.Number = 0)
    Err.Clear
    If ok Then Line Input #f, oneLine
    ok = ok And (Err.Number = 0)
    Err.Clear
    If ok Then Line Input #f, oneLine
    e3 = Err.Number
    Close #f
    If Not ok Then Exit Function
    If e3 = 0 Then
    If Trim(oneLine) = "close-after-run" Then CloseMode = "close" Else CloseMode = "unknown"
    ElseIf e3 = 62 And ok Then
    CloseMode = "keep"
    End If
End Function

Function OwnedDocTitle() As String
    On Error Resume Next
    OwnedDocTitle = ""
    If swDoc Is Nothing Then Exit Function
    OwnedDocTitle = "" & swDoc.GetTitle
End Function
