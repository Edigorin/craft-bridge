' craft-bridge probe-selplane - why does Select return False on a live
' RefPlane feature? The mirror step found its plane object (gPlane=<Top
' Plane>, object-found=True) yet both the object Select and SelectByID2
' failed - after a sketch and an extrude. This probe isolates the state:
' select the plane before the sketch, after the sketch, and after the
' extrude, capturing each result and error separately.
Option Explicit

Dim swApp As SldWorks.SldWorks
Dim swDoc As SldWorks.ModelDoc2
Dim swSketchMgr As SketchManager
Dim reportPath As String
Dim gProbeLog As String

Sub main()
    Dim template As String
    Dim pf As SldWorks.Feature
    Dim uncertain As Boolean
    Dim ln As Object
    Dim feat As Object
    Dim ok As Boolean
    Dim runFailed As Boolean
    Dim closedOk As Boolean
    Dim cleanupMode As String
    Dim errNum As Long
    Dim errMsg As String
    On Error GoTo Fail
    runFailed = False
    reportPath = ReportPathFromHost()
    If reportPath = "" Then Err.Raise vbObjectError + 513, "probe-selplane", "no report path"
    StartReport
    WriteLine "{""type"":""header"",""macro"":""probe-selplane"",""bridge_version"":""0.1.0""}"
    Set swApp = Application.SldWorks
    template = swApp.GetUserPreferenceStringValue(swUserPreferenceStringValue_e.swDefaultTemplatePart)
    If template = "" Then Err.Raise vbObjectError + 514, "probe-selplane", "no default part template"
    Set swDoc = swApp.NewDocument(template, 0, 0, 0)
    If swDoc Is Nothing Then Err.Raise vbObjectError + 515, "probe-selplane", "no document"
    Set swSketchMgr = swDoc.SketchManager
    WriteLine "{""type"":""step"",""index"":-1,""command"":""document.new"",""status"":""created"",""message"":""fresh part from the default template""}"
    WriteLine TrySelect("before-sketch")
    If Not OpenFirstPlane() Then
        WriteStep 0, "sketch.open", "failed", gProbeLog
        runFailed = True
        GoTo WrapUp
    End If
    Set ln = swSketchMgr.CreateLine(0.01, 0.01, 0#, 0.05, 0.01, 0#)
    Set ln = swSketchMgr.CreateLine(0.05, 0.01, 0#, 0.05, 0.03, 0#)
    Set ln = swSketchMgr.CreateLine(0.05, 0.03, 0#, 0.01, 0.03, 0#)
    Set ln = swSketchMgr.CreateLine(0.01, 0.03, 0#, 0.01, 0.01, 0#)
    swDoc.ClearSelection2 True
    swSketchMgr.InsertSketch True
    WriteLine TrySelect("after-sketch")
    ok = swDoc.Extension.SelectByID2("Sketch1", "SKETCH", 0#, 0#, 0#, False, 0, Nothing, swSelectOption_e.swSelectOptionDefault)
    WriteLine LineFor("select-sketch-byname", 0, "", "result=" & CStr(ok))
    Set feat = gFeatMgr2()
    If feat Is Nothing Then
        WriteStep 1, "extrude", "failed", "no feature manager"
        runFailed = True
        GoTo WrapUp
    End If
    Set feat = feat.FeatureExtrusion2(True, False, False, swEndConditions_e.swEndCondBlind, swEndConditions_e.swEndCondBlind, 0.01, 0#, False, False, False, False, 0#, 0#, False, False, False, False, True, True, True, 0, 0#, False)
    WriteLine LineFor("extrude", 0, "", "feat-is-nothing=" & CStr(feat Is Nothing))
    WriteLine TrySelect("after-extrude")
    If Not feat Is Nothing Then
        swDoc.ClearSelection2 True
        ok = feat.Select(False)
        WriteLine LineFor("seed-select", 0, "", "result=" & CStr(ok))
        WriteLine TrySelect("after-seed-select")
        swDoc.ClearSelection2 True
    End If
    WriteLine ProbeDance()
    WriteLine TrySelect("after-dance")
WrapUp:
    cleanupMode = CloseMode()
    If cleanupMode = "close" Then
        CloseOwnedDoc closedOk
        If closedOk And Not runFailed Then
            WriteLine "{""type"":""summary"",""status"":""ok""}"
        Else
            If Not closedOk Then WriteStep 5, "close", "failed", "the owned document could not be confirmed closed"
            WriteLine "{""type"":""summary"",""status"":""failed""}"
        End If
    ElseIf cleanupMode = "keep" Then
        WriteStep 5, "owned-document", "kept-open", OwnedDocTitle()
        If runFailed Then
            WriteLine "{""type"":""summary"",""status"":""failed""}"
        Else
            WriteLine "{""type"":""summary"",""status"":""ok""}"
        End If
    Else
        WriteStep 5, "close-mode", "failed", "the cleanup mode could not be established"
        WriteLine "{""type"":""summary"",""status"":""failed""}"
    End If
    Exit Sub
Fail:
    errNum = Err.Number
    errMsg = Err.Description
    On Error Resume Next
    WriteLine "{""type"":""step"",""index"":-1,""command"":""probe"",""status"":""failed"",""message"":""" & JsonStr("err " & Trim(Str(errNum)) & ": " & errMsg) & """}"
    cleanupMode = CloseMode()
    If cleanupMode = "close" Then CloseOwnedDoc closedOk
    WriteLine "{""type"":""summary"",""status"":""failed""}"
End Sub

Function gFeatMgr2() As Object
    On Error Resume Next
    Set gFeatMgr2 = swDoc.FeatureManager
End Function

' Find the Top Plane feature and try every selection path, capturing each.
Function TrySelect(ByVal tag As String) As String
    Dim pf As SldWorks.Feature
    Dim uncertain As Boolean
    Dim ok As Boolean
    Dim detail As String
    On Error Resume Next
    Set pf = FindFeatureByName("Top Plane", uncertain)
    detail = "object-found=" & CStr(Not pf Is Nothing) & " uncertain=" & CStr(uncertain)
    If Not pf Is Nothing Then
        Err.Clear
        ok = pf.Select(False)
        detail = detail & " obj-select=" & CStr(ok) & " err=" & Trim(Str(Err.Number)) & " " & Err.Description
    End If
    Err.Clear
    ok = swDoc.Extension.SelectByID2("Top Plane", "PLANE", 0#, 0#, 0#, False, 0, Nothing, swSelectOption_e.swSelectOptionDefault)
    detail = detail & " name-select=" & CStr(ok) & " err=" & Trim(Str(Err.Number)) & " " & Err.Description
    Err.Clear
    ok = swDoc.Extension.SelectByID2("Top Plane", "REFPLANE", 0#, 0#, 0#, False, 0, Nothing, swSelectOption_e.swSelectOptionDefault)
    detail = detail & " refplane-select=" & CStr(ok) & " err=" & Trim(Str(Err.Number)) & " " & Err.Description
    swDoc.ClearSelection2 True
    TrySelect = LineFor("selplane-" & tag, 0, "", detail)
End Function

' Replicate the PlaneNameFor dance: create a sketch on a plane, then close
' and delete it, then report the plane selection state.
Function ProbeDance() As String
    Dim pf As SldWorks.Feature
    Dim uncertain As Boolean
    Dim sk As Object
    Dim nm As String
    Dim detail As String
    Dim ok As Boolean
    On Error Resume Next
    Set pf = FindFeatureByName("Front Plane", uncertain)
    If pf Is Nothing Then
        ProbeDance = LineFor("dance", -1, "no front plane", "")
        Exit Function
    End If
    ok = pf.Select(False)
    If ok Then
        swSketchMgr.InsertSketch True
        Set sk = swSketchMgr.ActiveSketch
        If Not sk Is Nothing Then
            nm = sk.Name
            swSketchMgr.InsertSketch True
            Set pf = FindFeatureByName(nm, uncertain)
            detail = "dance-sketch=" & nm & " re-found=" & CStr(Not pf Is Nothing)
            If Not pf Is Nothing Then
                swDoc.ClearSelection2 True
                ok = pf.Select(False)
                If ok Then swDoc.EditDelete
                detail = detail & " deleted-select=" & CStr(ok)
            End If
        Else
            detail = "no active sketch in dance"
        End If
    Else
        detail = "front plane would not select for the dance"
    End If
    swDoc.ClearSelection2 True
    ProbeDance = LineFor("dance", 0, "", detail)
End Function

Function LineFor(ByVal which As String, ByVal n As Long, ByVal d As String, ByVal detail As String) As String
    LineFor = "{""type"":""probe"",""member"":""" & JsonStr(which) & """,""err"":" & Trim(Str(n)) & ",""errdesc"":""" & JsonStr(d) & """,""detail"":""" & JsonStr(detail) & """}"
End Function

Function OpenFirstPlane() As Boolean
    Dim feat As Object
    Dim nm As String
    Dim fname As String
    Dim sk As Object
    Dim sel As Boolean
    On Error Resume Next
    OpenFirstPlane = False
    gProbeLog = ""
    Set feat = swDoc.FirstFeature
    Do While Not feat Is Nothing
        nm = feat.GetTypeName2()
        If InStr(1, nm, "lane", vbTextCompare) > 0 Then
            fname = feat.Name
            sel = feat.Select(False)
            If sel Then
                swSketchMgr.InsertSketch True
                Set sk = swSketchMgr.ActiveSketch
                If sk Is Nothing Then
                    gProbeLog = gProbeLog & fname & ": opened but no active sketch object; "
                    Exit Function
                End If
                gProbeLog = gProbeLog & fname & ": opened; "
                OpenFirstPlane = True
                Exit Function
            Else
                gProbeLog = gProbeLog & fname & ": select returned false; "
            End If
        End If
        Set feat = feat.GetNextFeature
    Loop
End Function

' Truncate the report so this run never inherits a previous run's lines.
Sub StartReport()
    On Error Resume Next
    Dim f As Integer
    f = FreeFile
    Open reportPath For Output As #f
    Close #f
End Sub

Sub WriteLine(ByVal text As String)
    On Error Resume Next
    Dim f As Integer
    f = FreeFile
    Open reportPath For Append As #f
    Print #f, text
    Close #f
End Sub

Sub WriteStep(ByVal idx As Long, ByVal command As String, ByVal status As String, ByVal message As String)
    WriteLine "{""type"":""step"",""index"":" & Trim(Str(idx)) & ",""command"":""" & JsonStr(command) & """,""status"":""" & JsonStr(status) & """,""message"":""" & JsonStr(message) & """}"
End Sub

' JSON string escaping. This is not VBA-literal escaping: it is only for the
' report file. Generated code strings are escaped separately by the generator.
Function JsonStr(ByVal s As String) As String
    Dim t As String
    t = Replace(s, "\", "\\")
    t = Replace(t, """", "\""")
    t = Replace(t, vbCrLf, "\n")
    t = Replace(t, vbCr, "\n")
    t = Replace(t, vbLf, "\n")
    t = Replace(t, vbTab, "\t")
    JsonStr = t
End Function

Sub CloseOwnedDoc(ByRef closedOk As Boolean)
    Dim exact As String
    Dim d As Object
    Dim t2 As String
    Dim cnt As Long
    Dim isOurs As Boolean
    On Error Resume Next
    closedOk = False
    If swDoc Is Nothing Then
        closedOk = True
        Exit Sub
    End If
    Err.Clear
    exact = swDoc.GetTitle
    If Err.Number <> 0 Then Exit Sub
    If Trim(exact) = "" Then Exit Sub
    Err.Clear
    Set d = swApp.GetFirstDocument
    If Err.Number <> 0 Then Exit Sub
    Do While Not d Is Nothing
        t2 = d.GetTitle
        If Err.Number <> 0 Then Exit Sub
        If t2 = exact Then
            cnt = cnt + 1
            If d Is swDoc Then isOurs = True
        End If
        Err.Clear
        Set d = d.GetNext
        If Err.Number <> 0 Then Exit Sub
    Loop
    If cnt <> 1 Or Not isOurs Then Exit Sub
    Err.Clear
    swApp.CloseDoc exact
    If Err.Number <> 0 Then Exit Sub
    Err.Clear
    Set d = swApp.GetFirstDocument
    If Err.Number <> 0 Then Exit Sub
    cnt = 0
    Do While Not d Is Nothing
        t2 = d.GetTitle
        If Err.Number <> 0 Then Exit Sub
        If t2 = exact Then cnt = cnt + 1
        Err.Clear
        Set d = d.GetNext
        If Err.Number <> 0 Then Exit Sub
    Loop
    If cnt = 0 Then closedOk = True
End Sub

Function CloseMode() As String
    Dim p As String, f As Integer, oneLine As String
    Dim ok As Boolean
    Dim e3 As Long
    CloseMode = "unknown"
    On Error Resume Next
    p = Environ$("TEMP")
    If p = "" Then Exit Function
    p = p & "\craft-bridge-report-path.txt"
    Err.Clear
    f = FreeFile
    Open p For Input As #f
    If Err.Number <> 0 Then Exit Function
    Err.Clear
    Line Input #f, oneLine
    ok = (Err.Number = 0)
    Err.Clear
    If ok Then Line Input #f, oneLine
    ok = ok And (Err.Number = 0)
    Err.Clear
    If ok Then Line Input #f, oneLine
    e3 = Err.Number
    Close #f
    If Not ok Then Exit Function
    If e3 = 0 Then
    If Trim(oneLine) = "close-after-run" Then CloseMode = "close" Else CloseMode = "unknown"
    ElseIf e3 = 62 And ok Then
    CloseMode = "keep"
    End If
End Function

Function OwnedDocTitle() As String
    On Error Resume Next
    OwnedDocTitle = ""
    If swDoc Is Nothing Then Exit Function
    OwnedDocTitle = "" & swDoc.GetTitle
End Function

Function ReportPathFromHost() As String
    Dim p As String, f As Integer, oneLine As String
    Dim got As Boolean
    ReportPathFromHost = ""
    On Error Resume Next
    p = Environ$("TEMP")
    If p <> "" Then
    p = p & "\craft-bridge-report-path.txt"
    Err.Clear
    f = FreeFile
    Open p For Input As #f
    If Err.Number = 0 Then
    Err.Clear
    Line Input #f, oneLine
    got = (Err.Number = 0)
    Err.Clear
    Close #f
    If got Then
    oneLine = Trim(oneLine)
    If oneLine <> "" Then
    ReportPathFromHost = oneLine
    Exit Function
    End If
    End If
    End If
    Err.Clear
    End If
    ReportPathFromHost = Trim(Environ$("CRAFT_BRIDGE_REPORT"))
    End Function

Function FindFeatureByName(ByVal nm As String, ByRef uncertain As Boolean) As SldWorks.Feature
    Dim feat As SldWorks.Feature, fn As String
    Set FindFeatureByName = Nothing
    uncertain = True
    If nm = "" Then Exit Function
    On Error Resume Next
    Err.Clear
    Set feat = swDoc.FirstFeature
    Do While Not feat Is Nothing
        If Err.Number <> 0 Then Exit Function
        Err.Clear
        fn = feat.Name
        If Err.Number <> 0 Then Exit Function
        If fn = nm Then
            Set FindFeatureByName = feat
            uncertain = False
            Exit Function
        End If
        Err.Clear
        Set feat = feat.GetNextFeature
    Loop
    If Err.Number = 0 Then uncertain = False
End Function
