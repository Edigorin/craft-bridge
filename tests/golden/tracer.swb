' Generated by craft-bridge 0.1.0 from "tracer.craftx" - review before running.
' Units: the SolidWorks API always takes metres and radians.
Option Explicit

Dim swApp As SldWorks.SldWorks
Dim swDoc As SldWorks.ModelDoc2
Dim swSketchMgr As SketchManager
Dim reportPath As String
Dim gMsg As String
Dim skName2 As String
Dim pt2(0 To 7) As SldWorks.SketchPoint
Dim sl2(0 To 3) As SldWorks.SketchLine

Sub main()
    Dim template As String
    Dim ok As Boolean
    Dim st As String
    Dim stopModel As Boolean
    Dim stepIdx As Long
    stepIdx = -1
    On Error GoTo Fail

    ' ---- report setup (before any model mutation) ----
    reportPath = ReportPathFromHost()
    If reportPath = "" Then Err.Raise vbObjectError + 513, "craft-bridge", "no report path: CRAFT_BRIDGE_REPORT is unset and no path file exists in TEMP"
    Open reportPath For Output As #1
    Print #1, "{""type"":""header"",""macro"":""tracer.craftx"",""bridge_version"":""0.1.0""}"
    FlushReport

    ' ---- step 0: document.units ----
    stepIdx = 0
    WriteStep stepIdx, "document.units", "not-executed", "units recorded (in); values replay in millimetres"

    ' ---- step 1: parameters.add ----
    stepIdx = 1
    If Not stopModel Then
        st = AddGlobalEquation("width", "40mm", 0.04)
    Else
        st = "not-executed"
        gMsg = "after the first stopped step"
    End If
    WriteStep stepIdx, "parameters.add", st, gMsg
    If st = "failed" Then stopModel = True

    ' ---- step 2: timeline.add ----
    stepIdx = 2
    If Not stopModel Then
        st = BuildSketch2()
    Else
        st = "not-executed"
        gMsg = "after the first stopped step"
    End If
    WriteStep stepIdx, "timeline.add", st, gMsg
    If st = "failed" Then stopModel = True

    ' ---- step 3: timeline.add ----
    stepIdx = 3
    If Not stopModel Then
        st = BuildExtrude3()
    Else
        st = "not-executed"
        gMsg = "after the first stopped step"
    End If
    WriteStep stepIdx, "timeline.add", st, gMsg
    If st = "failed" Then stopModel = True

    Print #1, "{""type"":""summary"",""status"":""ok""}"
    Close #1
    Exit Sub

Fail:
    ' The report must survive failure: open it if needed, write what happened
    ' and the completion signal, then leave the model as it is.
    On Error Resume Next
    If reportPath = "" Then reportPath = ReportPathFromHost()
    If reportPath <> "" Then
        Open reportPath For Append As #1
        Print #1, "{""type"":""step"",""index"":" & Trim(Str(stepIdx)) & ",""command"":""macro"",""status"":""failed"",""message"":""" & JsonStr(Err.Description) & """}"
        Print #1, "{""type"":""summary"",""status"":""failed""}"
        Close #1
    End If
End Sub

' Sketch step 2: "Profile"
Function BuildSketch2() As String
    On Error GoTo HardFail
    Dim ok As Boolean
    ok = swDoc.Extension.SelectByID2("Front Plane", "PLANE", 0#, 0#, 0#, False, 0, Nothing, swSelectOption_e.swSelectOptionDefault)
    If Not ok Then gMsg = "could not select the Front Plane plane": GoTo SketchFailed
    swSketchMgr.InsertSketch True
    gSketchName = swSketchMgr.ActiveSketch.Name
    DrawGeometry2
    If Not Relations2() Then GoTo Degrade
    If Not Dims2() Then GoTo Degrade
    If Not VerifySketch2() Then GoTo Degrade
    swSketchMgr.InsertSketch True
    gMsg = "8 relations and 2 dimensions replayed"
    BuildSketch2 = "created"
    Exit Function

Degrade:
' Restore, do not merely delete relations: wipe the sketch contents,
' redraw at the stored coordinates, reapply driving dimensions, verify again.
CleanSketch2
    DrawGeometry2
    If Not Dims2() Then GoTo SketchFailed
    If Not VerifySketch2() Then GoTo SketchFailed
    swSketchMgr.InsertSketch True
    gMsg = "rebuilt as geometry plus driving dimensions"
    BuildSketch2 = "degraded"
    Exit Function

SketchFailed:
    On Error Resume Next
    swSketchMgr.InsertSketch True
    BuildSketch2 = "failed"
    Exit Function

HardFail:
    On Error Resume Next
    swSketchMgr.InsertSketch True
    gMsg = Err.Description
    BuildSketch2 = "failed"
End Function

Sub DrawGeometry2()
    Set sl2(0) = swSketchMgr.CreateLine(0.0, 0.0, 0#, 0.04, 0.0, 0#)
    Set pt2(0) = sl2(0).GetStartPoint
    Set pt2(1) = sl2(0).GetEndPoint
    Set sl2(1) = swSketchMgr.CreateLine(0.04, 0.0, 0#, 0.04, 0.02, 0#)
    Set pt2(2) = sl2(1).GetStartPoint
    Set pt2(3) = sl2(1).GetEndPoint
    Set sl2(2) = swSketchMgr.CreateLine(0.04, 0.02, 0#, 0.0, 0.02, 0#)
    Set pt2(4) = sl2(2).GetStartPoint
    Set pt2(5) = sl2(2).GetEndPoint
    Set sl2(3) = swSketchMgr.CreateLine(0.0, 0.02, 0#, 0.0, 0.0, 0#)
    Set pt2(6) = sl2(3).GetStartPoint
    Set pt2(7) = sl2(3).GetEndPoint
    swDoc.ClearSelection2 True
End Sub

Function Relations2() As Boolean
    On Error GoTo RelFail
    pt2(1).Select False
    pt2(2).Select True
    swDoc.SketchAddConstraints "sgCoincident"
    swDoc.ClearSelection2 True
    pt2(3).Select False
    pt2(4).Select True
    swDoc.SketchAddConstraints "sgCoincident"
    swDoc.ClearSelection2 True
    pt2(5).Select False
    pt2(6).Select True
    swDoc.SketchAddConstraints "sgCoincident"
    swDoc.ClearSelection2 True
    pt2(0).Select False
    pt2(7).Select True
    swDoc.SketchAddConstraints "sgCoincident"
    swDoc.ClearSelection2 True
    sl2(0).Select False
    swDoc.SketchAddConstraints "sgHorizontal"
    swDoc.ClearSelection2 True
    sl2(1).Select False
    swDoc.SketchAddConstraints "sgVertical"
    swDoc.ClearSelection2 True
    sl2(2).Select False
    swDoc.SketchAddConstraints "sgHorizontal"
    swDoc.ClearSelection2 True
    sl2(3).Select False
    swDoc.SketchAddConstraints "sgVertical"
    swDoc.ClearSelection2 True
    Relations2 = True
    Exit Function
RelFail:
    Relations2 = False
End Function

Function Dims2() As Boolean
    On Error GoTo DimFail
    Dim dd As SldWorks.DisplayDimension
    Dim dm As SldWorks.Dimension
    sl2(0).Select False
    Set dd = swDoc.AddDimension2(0.03, 0.01, 0#)
    If dd Is Nothing Then GoTo DimFail
    Set dm = dd.GetDimension2(0)
    If dm Is Nothing Then GoTo DimFail
    dm.SystemValue = 0.04
    If Not AddDimEquation(dm, "40mm", 0.04) Then GoTo DimFail
    swDoc.ClearSelection2 True
    sl2(1).Select False
    Set dd = swDoc.AddDimension2(0.05, 0.02, 0#)
    If dd Is Nothing Then GoTo DimFail
    Set dm = dd.GetDimension2(0)
    If dm Is Nothing Then GoTo DimFail
    dm.SystemValue = 0.02
    If Not AddDimEquation(dm, "20mm", 0.02) Then GoTo DimFail
    swDoc.ClearSelection2 True
    Dims2 = True
    Exit Function
DimFail:
    Dims2 = False
End Function

Function VerifySketch2() As Boolean
    Const TOL As Double = 0.000001
    On Error GoTo VerifyFail
    If Abs(pt2(0).X - 0.0) > TOL Then GoTo VerifyFail
    If Abs(pt2(0).Y - 0.0) > TOL Then GoTo VerifyFail
    If Abs(pt2(1).X - 0.04) > TOL Then GoTo VerifyFail
    If Abs(pt2(1).Y - 0.0) > TOL Then GoTo VerifyFail
    If Abs(pt2(2).X - 0.04) > TOL Then GoTo VerifyFail
    If Abs(pt2(2).Y - 0.0) > TOL Then GoTo VerifyFail
    If Abs(pt2(3).X - 0.04) > TOL Then GoTo VerifyFail
    If Abs(pt2(3).Y - 0.02) > TOL Then GoTo VerifyFail
    If Abs(pt2(4).X - 0.04) > TOL Then GoTo VerifyFail
    If Abs(pt2(4).Y - 0.02) > TOL Then GoTo VerifyFail
    If Abs(pt2(5).X - 0.0) > TOL Then GoTo VerifyFail
    If Abs(pt2(5).Y - 0.02) > TOL Then GoTo VerifyFail
    If Abs(pt2(6).X - 0.0) > TOL Then GoTo VerifyFail
    If Abs(pt2(6).Y - 0.02) > TOL Then GoTo VerifyFail
    If Abs(pt2(7).X - 0.0) > TOL Then GoTo VerifyFail
    If Abs(pt2(7).Y - 0.0) > TOL Then GoTo VerifyFail
    VerifySketch2 = True
    Exit Function
VerifyFail:
    VerifySketch2 = False
End Function

Sub CleanSketch2()
    Dim anySel As Boolean
    If Not pt2(0) Is Nothing Then
        pt2(0).Select False
        anySel = True
    End If
    swDoc.EditDelete
    swDoc.ClearSelection2 True
End Sub

' Extrude step 3: "Base"
Function BuildExtrude3() As String
    On Error GoTo HardFail
    Dim ok As Boolean
    Dim feat As SldWorks.Feature
    Dim dm As SldWorks.Dimension
    ok = swDoc.Extension.SelectByID2(skName2, "SKETCH", 0#, 0#, 0#, False, 0, Nothing, swSelectOption_e.swSelectOptionDefault)
    If Not ok Then gMsg = "could not select the sketch for the extrude": GoTo ExFail
    Set feat = swDoc.FeatureManager.FeatureExtrusion2(True, False, False, swEndConditions_e.swEndCondBlind, swEndConditions_e.swEndCondBlind, 0.012, 0#, False, False, False, False, 0#, 0#, False, False, False, False, True, True, True)
    If feat Is Nothing Then gMsg = "the extrude was not created": GoTo ExFail
    Set dm = swDoc.Parameter("D1@" & feat.Name)
    If dm Is Nothing Then gMsg = "the extrude dimension D1 is missing": GoTo ExFail
    If Abs(dm.SystemValue - 0.012) > 0.000001 Then gMsg = "the extrude dimension D1 does not match": GoTo ExFail
    gMsg = "depth 0.012 m"
    BuildExtrude3 = "created"
    Exit Function

ExFail:
    BuildExtrude3 = "failed"
    Exit Function

HardFail:
    On Error Resume Next
    gMsg = Err.Description
    BuildExtrude3 = "failed"
End Function

' Write one step line and flush it to disk immediately.
Sub WriteStep(ByVal idx As Long, ByVal command As String, ByVal status As String, ByVal message As String)
On Error Resume Next
Print #1, "{""type"":""step"",""index"":" & Trim(Str(idx)) & ",""command"":""" & JsonStr(command) & """,""status"":""" & JsonStr(status) & """,""message"":""" & JsonStr(message) & """}"
FlushReport
End Sub

' Close and reopen the report so the line just written reaches the disk.
Sub FlushReport()
On Error Resume Next
Close #1
Open reportPath For Append As #1
End Sub

' The report path travels in the host's environment or in a one-line path
' file under %%TEMP%%, because the macro runs inside the SolidWorks process.
Function ReportPathFromHost() As String
Dim p As String, f As Integer, oneLine As String
p = Environ$("CRAFT_BRIDGE_REPORT")
If p <> "" Then
ReportPathFromHost = p
Exit Function
End If
p = Environ$("TEMP")
If p = "" Then Exit Function
p = p & "\craft-bridge-report-path.txt"
Err.Clear
On Error Resume Next
f = FreeFile
Open p For Input As #f
If Err.Number = 0 Then
Line Input #f, oneLine
Close #f
If Err.Number = 0 Then ReportPathFromHost = Trim(oneLine)
End If
End Sub

' JSON string escaping for the report file only.
Function JsonStr(ByVal s As String) As String
Dim t As String
t = Replace(s, "\", "\\")
t = Replace(t, """", "\"")
t = Replace(t, vbCrLf, "\n")
t = Replace(t, vbCr, "\n")
t = Replace(t, vbLf, "\n")
t = Replace(t, vbTab, "\t")
JsonStr = t
End Function

' Add a global-variable equation and rebuild. The name is a global, the
' right-hand side is equation syntax. Globals are verified through the
' dimensions that reference them.
Function AddGlobalEquation(ByVal nm As String, ByVal rhs As String, ByVal expect As Double) As String
On Error GoTo EqFail
Dim eqMgr As SldWorks.EquationMgr
Dim eqText As String
Set eqMgr = swDoc.GetEquationMgr
If eqMgr Is Nothing Then gMsg = "the equation manager is missing": AddGlobalEquation = "failed": Exit Function
eqText = """" & nm & """=" & rhs
eqMgr.Add2 -1, eqText
swDoc.EditRebuild3
gMsg = "equation " & eqText
AddGlobalEquation = "created"
Exit Function
EqFail:
gMsg = "equation failed: " & Err.Description
AddGlobalEquation = "failed"
End Function

' Add an equation driving a dimension and verify it evaluated: the
' dimension name is captured at runtime, the value must match the
' expectation after a rebuild. Never presence alone.
Function AddDimEquation(ByVal dm As SldWorks.Dimension, ByVal rhs As String, ByVal expect As Double) As Boolean
On Error GoTo EqFail
Dim eqMgr As SldWorks.EquationMgr
Dim eqText As String
Set eqMgr = swDoc.GetEquationMgr
If eqMgr Is Nothing Then GoTo EqFail
eqText = """" & dm.Name & """=" & rhs
eqMgr.Add2 -1, eqText
swDoc.EditRebuild3
If Abs(dm.SystemValue - expect) > 0.000001 Then GoTo EqFail
AddDimEquation = True
Exit Function
EqFail:
AddDimEquation = False
End Function
